CREATE TABLE `t_client_business_profile` (\n  `business_profile_id` bigint NOT NULL COMMENT 'Client 单份经营资料稳定标识，不是版本标识。',\n  `client_id` bigint NOT NULL COMMENT '平台 Client 角色的内部唯一标识。',\n  `business_model_code` varchar(64) DEFAULT NULL COMMENT 'Client 声明商业模式的受控业务代码。取值来源：Client Business Model Catalog；非固定枚举。',\n  `website_url` varchar(2048) DEFAULT NULL COMMENT 'Client 对外经营网站的受控 URL；无网站时可为空。',\n  `expected_volume` decimal(24,8) DEFAULT NULL COMMENT '预计月交易金额，使用 currency 指定币种；提交时大于零。',\n  `expected_ticket` decimal(24,8) DEFAULT NULL COMMENT 'Client 声明的预期单笔交易金额。',\n  `currency` char(3) DEFAULT NULL COMMENT '预期交易量与客单价采用的精确 ISO 4217 三位币种代码。取值来源：ISO 4217；非固定枚举。',\n  `content_hash` char(64) DEFAULT NULL COMMENT '已批准单份经营资料内容摘要；未批准为空，不用于草稿版本冲突控制。',\n  `create_time` datetime(6) NOT NULL COMMENT '数据库记录创建的 UTC 时间，精确到微秒。',\n  `update_time` datetime(6) NOT NULL COMMENT '数据库记录最后一次更新的 UTC 时间，精确到微秒。',\n  `business_description` varchar(2000) DEFAULT NULL COMMENT '客户实际商品、服务、客户群体及销售方式说明；草稿可空，提交必填。',\n  `expected_payment_methods` varchar(512) DEFAULT NULL COMMENT 'Client 期望开通的支付方式：commercial 产品能力目录 capability_kind=PAYMENT_METHOD 的 capability_code，大写、去重、按代码升序、英文逗号分隔（如 APPLE_PAY,CARD），最多 20 项；草稿可空，提交按 Schema 要求级别校验且每项须为 ACTIVE；仅作审核与商务参考，不代表已开通。取值来源：commercial t_product_capability；非固定枚举。',\n  `refund_policy_url` varchar(2048) DEFAULT NULL COMMENT 'Client 对外公示的退款政策页面 https 网址；草稿可空，机构申请批准前必填、个人申请可选（按 Schema 要求级别）；不校验页面内容。',\n  `fulfillment_type` varchar(32) DEFAULT NULL COMMENT 'Client 向消费者交付商品或服务的方式；草稿可空，提交必填。取值来源：t_catalog_item 目录 FULFILLMENT_TYPE（INSTANT、PRE_ORDER、SUBSCRIPTION、SERVICE）；非固定枚举。',\n  `fulfillment_days` smallint DEFAULT NULL COMMENT '预售从付款到交付的预计天数，1—365；只在 fulfillment_type=PRE_ORDER 时有值，改为其他交付方式时清空。',\n  `classification_case_id` bigint DEFAULT NULL COMMENT '本组运营分类所属 Risk 主审核任务；外部引用，不建物理外键。',\n  `classification_confirmed_by` bigint DEFAULT NULL COMMENT '确认本任务分类的 Operations Account；与确认时间成组。',\n  `classification_confirmed_time` datetime(6) DEFAULT NULL COMMENT '本任务分类确认的 UTC 时间；为空时仅为可编辑草稿。',\n  PRIMARY KEY (`business_profile_id`),\n  UNIQUE KEY `uk_client_business_client` (`client_id`) COMMENT 'Unique index for client_business_profile on client_id'\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='客户业务资料；uk_client_business_client(client_id)；每个 Client 一份业务资料；Client 填写经营说明，运营确认行业及 MCC；批准分类任务和确认人随资料冻结；应用校验，不创建 CHECK/FK'
CREATE TABLE `t_onboarding_schema_field` (\n  `schema_field_id` bigint NOT NULL COMMENT '采集 Schema 字段行的内部唯一标识。',\n  `schema_id` bigint NOT NULL COMMENT '所属采集 Schema 版本标识。',\n  `section` varchar(32) NOT NULL COMMENT '前端分区。允许值：BASIC、BUSINESS、PEOPLE、MATERIALS、DECLARATIONS。',\n  `display_group` varchar(64) NOT NULL COMMENT '分区内分组代码，如 IDENTITY、REGISTRATION、ADDRESS。取值来源：Schema DML；非固定枚举。',\n  `field_key` varchar(128) NOT NULL COMMENT '字段键，等于草稿 values 的分区.字段路径（如 individual.birthPlace、attributes.AE_FREE_ZONE_CODE）或 identifier.<标识类型>、declaration.<声明类型>、address、people。取值来源：Schema DML；非固定枚举。',\n  `widget_code` varchar(32) NOT NULL COMMENT '前端控件代码，由前端控件注册表解释。允许值：TEXT、TEXTAREA、DATE、COUNTRY、SELECT、MULTI_SELECT、IDENTIFIER、ADDRESS、NAME、PERSON_LIST、DOCUMENT_SLOT、DECLARATION、URL、MONEY、EMAIL、PHONE、BOOLEAN。',\n  `catalog_code` varchar(64) DEFAULT NULL COMMENT 'SELECT 与 MULTI_SELECT 控件的取值目录代码；REF_ 开头时为 Platform 参考数据（如 REF_CURRENCY）；COMMERCIAL_PAYMENT_METHOD 表示 commercial 产品能力目录的支付方式（外部目录，不在 t_catalog_item）；其他控件为空。取值来源：t_catalog_item.catalog_code、REF_ 保留码或 COMMERCIAL_PAYMENT_METHOD；非固定枚举。',\n  `requirement_level` varchar(16) NOT NULL COMMENT '提交要求级别：REQUIRED 提交前必填，EVENTUALLY 批准前必填，OPTIONAL 可选，HIDDEN 不展示。允许值：REQUIRED、EVENTUALLY、OPTIONAL、HIDDEN。',\n  `requirement_group` varchar(64) DEFAULT NULL COMMENT '同组字段至少满足一个的组代码，如个人证件 NID 或 Iqama 或护照；为空表示单独计算。取值来源：Schema DML；非固定枚举。',\n  `applies_to_subject` varchar(16) NOT NULL COMMENT '字段适用的受审主体。允许值：PRIMARY、RELATED_PERSON、BOTH。',\n  `validation_pattern` varchar(255) DEFAULT NULL COMMENT '字段取值必须完整匹配的正则表达式；为空表示不限格式。',\n  `min_length` int DEFAULT NULL COMMENT '字段最少字符数；为空表示不限。',\n  `max_length` int DEFAULT NULL COMMENT '字段最多字符数；为空时取草稿存储上限。',\n  `visible_when` varchar(255) DEFAULT NULL COMMENT '简单可见条件 field_key=value；条件不满足时字段不展示、不校验；为空表示始终可见。',\n  `label_key` varchar(128) NOT NULL COMMENT '字段标题的界面文案键，命名空间 onboardingSchema。',\n  `help_key` varchar(128) DEFAULT NULL COMMENT '字段帮助说明的界面文案键；为空表示无帮助。',\n  `display_order` int NOT NULL COMMENT '同一分区内的展示顺序，数值越小越靠前。',\n  `create_time` datetime(6) NOT NULL COMMENT '数据库记录创建的 UTC 时间，精确到微秒。',\n  `update_time` datetime(6) NOT NULL COMMENT '数据库记录最后一次更新的 UTC 时间，精确到微秒。',\n  PRIMARY KEY (`schema_field_id`),\n  UNIQUE KEY `uk_schema_field` (`schema_id`,`field_key`,`applies_to_subject`) COMMENT 'Unique index for onboarding_schema_field on schema_id, field_key, applies_to_subject'\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='采集 Schema 字段，同时是前端渲染模板与后端提交校验的唯一来源；uk_schema_field(schema_id,field_key,applies_to_subject)；发布后不可修改'
CREATE TABLE `t_catalog_item` (\n  `catalog_item_id` bigint NOT NULL COMMENT '通用目录项的内部唯一标识。',\n  `catalog_code` varchar(64) NOT NULL COMMENT '目录代码，如 BUSINESS_MODEL、REGISTRATION_AUTHORITY、CITY；不得为 REF_ 开头的保留码或 COMMERCIAL_ 开头的外部目录码，也不得承载国家、币种、行政区或行业等 Platform 参考数据。取值来源：目录 DML；非固定枚举。',\n  `item_code` varchar(64) NOT NULL COMMENT '目录内稳定的取值代码。取值来源：目录 DML；非固定枚举。',\n  `jurisdiction_code` varchar(16) NOT NULL COMMENT '目录项适用的辖区代码；* 表示全局通用。取值来源：t_jurisdiction 或 *；非固定枚举。',\n  `label_key` varchar(128) NOT NULL COMMENT '目录项展示名称的界面文案键，命名空间 onboardingSchema。',\n  `client_types` varchar(64) DEFAULT NULL COMMENT '目录项适用的 Client 类型，逗号分隔；为空表示个人与组织都适用。允许值：INDIVIDUAL、ORGANIZATION 的组合。',\n  `display_order` int NOT NULL COMMENT '同一目录内的展示顺序，数值越小越靠前。',\n  `status` varchar(16) NOT NULL COMMENT '目录项状态；只有 ACTIVE 可被选择与校验通过。允许值：DRAFT、ACTIVE、RETIRED。',\n  `create_time` datetime(6) NOT NULL COMMENT '数据库记录创建的 UTC 时间，精确到微秒。',\n  `update_time` datetime(6) NOT NULL COMMENT '数据库记录最后一次更新的 UTC 时间，精确到微秒。',\n  PRIMARY KEY (`catalog_item_id`),\n  UNIQUE KEY `uk_catalog_item` (`catalog_code`,`jurisdiction_code`,`item_code`) COMMENT 'Unique index for catalog_item on catalog_code, jurisdiction_code, item_code'\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='通用目录项；uk_catalog_item(catalog_code,jurisdiction_code,item_code)；SELECT 控件、属性与地址组件的本服务取值来源；国家、币种、一级行政区、行业与 MCC 等全平台参考数据不得在本表维护（Platform 参考数据为 Owner），Schema 以 REF_ 保留目录码引用并在提交时向 Platform 校验；本表不得出现 REF_ 开头的目录码'
CREATE TABLE `t_onboarding_schema` (\n  `schema_id` bigint NOT NULL COMMENT '采集 Schema 版本的内部唯一标识；申请创建时冻结。',\n  `jurisdiction_code` varchar(16) NOT NULL COMMENT 'Schema 适用的辖区代码。取值来源：t_jurisdiction；非固定枚举。',\n  `party_type` varchar(16) NOT NULL COMMENT 'Schema 适用的申请主主体类型。允许值：INDIVIDUAL、ORGANIZATION。',\n  `role_type` varchar(32) NOT NULL COMMENT 'Schema 适用的业务角色；本期只有 Client 入驻。允许值：CLIENT。',\n  `organization_type_code` varchar(64) NOT NULL COMMENT '专用组织类型代码；* 表示该辖区该主体类型的默认 Schema。取值来源：t_organization_type.type_code 或 *；非固定枚举。',\n  `version_no` int NOT NULL COMMENT '同一 Schema 键下从 1 递增的版本号。',\n  `status` varchar(16) NOT NULL COMMENT 'Schema 版本状态；新申请只使用 ACTIVE，在途申请继续引用已冻结版本。允许值：DRAFT、ACTIVE、RETIRED。',\n  `active_slot` tinyint(1) DEFAULT NULL COMMENT '同一 Schema 键唯一 ACTIVE 版本的稀疏槽位。允许值：1 或 NULL。取值规则：状态为 ACTIVE 时为 1，其他状态为 NULL。',\n  `approved_by` bigint DEFAULT NULL COMMENT '发布该版本的 Operations Account；DML 预置版本为空。',\n  `approved_time` datetime(6) DEFAULT NULL COMMENT '版本发布为 ACTIVE 的 UTC 时间；DRAFT 为空。',\n  `create_time` datetime(6) NOT NULL COMMENT '数据库记录创建的 UTC 时间，精确到微秒。',\n  `update_time` datetime(6) NOT NULL COMMENT '数据库记录最后一次更新的 UTC 时间，精确到微秒。',\n  PRIMARY KEY (`schema_id`),\n  UNIQUE KEY `uk_schema_version` (`jurisdiction_code`,`party_type`,`role_type`,`organization_type_code`,`version_no`) COMMENT 'Unique index for onboarding_schema on jurisdiction_code, party_type, role_type, organization_type_code, version_no',\n  UNIQUE KEY `uk_schema_active` (`jurisdiction_code`,`party_type`,`role_type`,`organization_type_code`,`active_slot`) COMMENT 'Unique index for onboarding_schema on jurisdiction_code, party_type, role_type, organization_type_code, active_slot'\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='入驻采集 Schema 版本；uk_schema_active、uk_schema_version；按 辖区 × 主体类型 × 角色 × 组织类型 解析，组织类型无专用版本时取 * 默认版本；发布新版本不影响已冻结 schema_id 的在途申请'
