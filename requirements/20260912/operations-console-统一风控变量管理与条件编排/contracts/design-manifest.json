{
  "status": "APPROVED_STAGE_4_IN_PROGRESS",
  "tables": [
    {
      "name": "t_risk_variable",
      "comment": "统一拥有风控变量定义、来源映射、适用范围及当前常量值；不保存变量历史或执行结果",
      "fields": [
        {
          "name": "variable_id",
          "type": "BIGINT",
          "nullable": false,
          "comment": "变量的稳定标识，由 Risk 分配；不作为共享值版本。"
        },
        {
          "name": "variable_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": false,
          "comment": "全库唯一且创建后不可修改、不可复用的变量编码，格式为大写字母开头的大写字母数字下划线。取值来源：Risk 统一变量库；非固定枚举。"
        },
        {
          "name": "variable_name",
          "type": "VARCHAR(255)",
          "nullable": false,
          "comment": "运营展示名称，可修改；不参与规则或流程内容 Hash。"
        },
        {
          "name": "description",
          "type": "VARCHAR(500)",
          "nullable": true,
          "comment": "变量用途的非敏感说明；未填写时为空。"
        },
        {
          "name": "source_type",
          "type": "VARCHAR(64)",
          "nullable": false,
          "comment": "来源类型，允许 INPUT、CONSTANT、COLLECTION、NODE_OUTPUT；创建后固定。允许值：INPUT、CONSTANT、COLLECTION、NODE_OUTPUT。"
        },
        {
          "name": "value_type",
          "type": "VARCHAR(64)",
          "nullable": false,
          "comment": "标量类型或集合成员类型，允许 STRING、NUMBER、BOOLEAN、DATETIME、DURATION；创建后固定。允许值：STRING、NUMBER、BOOLEAN、DATETIME、DURATION。"
        },
        {
          "name": "point_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "适用决策点；INPUT 和 NODE_OUTPUT 必填，常量和集合为空表示全部已支持决策点。取值来源：Risk 决策点目录；非固定枚举。"
        },
        {
          "name": "source_contract_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "INPUT 的输入合同或 NODE_OUTPUT 的输出合同代码；其他来源为空。取值来源：Risk 精确输入或节点输出合同；非固定枚举。"
        },
        {
          "name": "source_contract_version",
          "type": "INT",
          "nullable": true,
          "comment": "来源合同的准确版本；仅 INPUT 和 NODE_OUTPUT 非空，不取最新版本兜底。"
        },
        {
          "name": "source_field",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "来源合同中的准确顶层字段键；仅 INPUT 和 NODE_OUTPUT 非空，不接受任意路径、SQL 或脚本。"
        },
        {
          "name": "rule_condition_flag",
          "type": "TINYINT(1)",
          "nullable": false,
          "comment": "是否可用于规则条件；0 或 1，受来源合同允许用途约束。"
        },
        {
          "name": "flow_condition_flag",
          "type": "TINYINT(1)",
          "nullable": false,
          "comment": "是否可用于流程连线条件；0 或 1，节点输出仅当前规则集节点出线可用。"
        },
        {
          "name": "action_parameter_flag",
          "type": "TINYINT(1)",
          "nullable": false,
          "comment": "是否可作为既有动作主体输入；0 或 1，本期只开放 INPUT 的批准主体槽位。"
        },
        {
          "name": "system_managed_flag",
          "type": "TINYINT(1)",
          "nullable": false,
          "comment": "是否为工程合同保留定义；0 或 1，系统定义的结构、状态、删除及系统集合成员不开放运营修改。"
        },
        {
          "name": "format_code",
          "type": "VARCHAR(64)",
          "nullable": false,
          "comment": "通用格式配置，允许 TEXT、UPPER_ALPHA_2、UPPER_ALPHA_3、DIGITS_4、TOKEN、BCP47、POSITIVE_ID、NONE；具体变量的关联由本行管理。允许值：TEXT、UPPER_ALPHA_2、UPPER_ALPHA_3、DIGITS_4、TOKEN、BCP47、POSITIVE_ID、NONE。"
        },
        {
          "name": "numeric_unit",
          "type": "VARCHAR(64)",
          "nullable": true,
          "comment": "NUMBER 的量纲，允许 SCALAR 或 MONEY；其他类型为空。允许值：SCALAR、MONEY。"
        },
        {
          "name": "currency_code",
          "type": "CHAR(3) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "MONEY 的固定币种，三位大写字母；与 currency_variable_code 二选一，非 MONEY 为空。取值来源：ISO 4217 币种代码；非固定枚举。"
        },
        {
          "name": "currency_variable_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "MONEY 的币种来源变量编码，指向同决策点 INPUT STRING 币种变量；与 currency_code 二选一，非 MONEY 为空。取值来源：Risk 统一变量库的币种输入；非固定枚举。"
        },
        {
          "name": "allowed_values_variable_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": true,
          "comment": "可选值来源集合变量编码，必须同成员类型且适用范围覆盖本变量；为空表示无额外枚举范围，集合本身不再引用集合。取值来源：Risk 统一变量库的集合；非固定枚举。"
        },
        {
          "name": "string_value",
          "type": "VARCHAR(512) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
          "nullable": true,
          "comment": "CONSTANT STRING 的当前值；仅匹配来源和值类型时非空，不接受敏感原值。"
        },
        {
          "name": "number_value",
          "type": "DECIMAL(24,8)",
          "nullable": true,
          "comment": "CONSTANT NUMBER 的当前精确数值；仅匹配来源和值类型时非空。"
        },
        {
          "name": "boolean_value",
          "type": "TINYINT(1)",
          "nullable": true,
          "comment": "CONSTANT BOOLEAN 的当前值，0 或 1；仅匹配来源和值类型时非空。"
        },
        {
          "name": "datetime_value",
          "type": "DATETIME(6)",
          "nullable": true,
          "comment": "CONSTANT DATETIME 的当前 UTC 微秒值；仅匹配来源和值类型时非空。"
        },
        {
          "name": "duration_value",
          "type": "BIGINT",
          "nullable": true,
          "comment": "CONSTANT DURATION 的当前非负毫秒值；仅匹配来源和值类型时非空。"
        },
        {
          "name": "status",
          "type": "VARCHAR(64)",
          "nullable": false,
          "comment": "当前状态，允许 ACTIVE、DISABLED、DELETED；停用禁止新保存引用，删除仅无任何引用时允许且保留编码。允许值：ACTIVE、DISABLED、DELETED。"
        },
        {
          "name": "version",
          "type": "BIGINT",
          "nullable": false,
          "comment": "变量根的正整数 CAS 版本，定义、值或集合成员成功变更时加一。"
        },
        {
          "name": "create_by",
          "type": "BIGINT",
          "nullable": false,
          "comment": "创建主体的稳定账号或正式系统主体标识。"
        },
        {
          "name": "update_by",
          "type": "BIGINT",
          "nullable": false,
          "comment": "最近修改主体的稳定账号或正式系统主体标识。"
        },
        {
          "name": "create_time",
          "type": "DATETIME(6)",
          "nullable": false,
          "comment": "Risk 数据库中的 UTC 微秒创建时间。"
        },
        {
          "name": "update_time",
          "type": "DATETIME(6)",
          "nullable": false,
          "comment": "变量定义或成员最近成功更新的 UTC 微秒时间。"
        }
      ],
      "indexes": [
        {
          "name": "PRIMARY",
          "columns": [
            "variable_id"
          ],
          "kind": "PRIMARY",
          "comment": "变量标识"
        },
        {
          "name": "uk_risk_variable_code",
          "columns": [
            "variable_code"
          ],
          "kind": "UNIQUE",
          "comment": "保证变量编码永久唯一"
        },
        {
          "name": "idx_risk_variable_filter",
          "columns": [
            "status",
            "source_type",
            "variable_code"
          ],
          "kind": "INDEX",
          "comment": "支持可用目录按状态和来源查询"
        },
        {
          "name": "idx_risk_variable_options",
          "columns": [
            "allowed_values_variable_code"
          ],
          "kind": "INDEX",
          "comment": "支持集合被用作可选值来源的反查"
        },
        {
          "name": "idx_risk_variable_currency",
          "columns": [
            "currency_variable_code"
          ],
          "kind": "INDEX",
          "comment": "支持币种变量使用关系和删除保护"
        }
      ]
    },
    {
      "name": "t_risk_variable_member",
      "comment": "保存同类型集合的当前成员及展示名称；由所属变量根统一事务与 CAS 管理，不建立成员版本",
      "fields": [
        {
          "name": "member_id",
          "type": "BIGINT",
          "nullable": false,
          "comment": "集合成员行标识，整体替换时可重新分配；不是变量版本。"
        },
        {
          "name": "variable_code",
          "type": "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin",
          "nullable": false,
          "comment": "所属 COLLECTION 变量编码，成员类型和量纲由变量根统一拥有。取值来源：Risk 统一变量库；非固定枚举。"
        },
        {
          "name": "value_key",
          "type": "VARCHAR(512) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
          "nullable": false,
          "comment": "成员按通用类型规范化后的精确字符串键，用于唯一去重；不包含 Hash，字符串大小写及前导零保留。"
        },
        {
          "name": "string_value",
          "type": "VARCHAR(512) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin",
          "nullable": true,
          "comment": "STRING 成员值；仅该类型非空。"
        },
        {
          "name": "number_value",
          "type": "DECIMAL(24,8)",
          "nullable": true,
          "comment": "NUMBER 成员精确数值；仅该类型非空。"
        },
        {
          "name": "boolean_value",
          "type": "TINYINT(1)",
          "nullable": true,
          "comment": "BOOLEAN 成员值，0 或 1；仅该类型非空。"
        },
        {
          "name": "datetime_value",
          "type": "DATETIME(6)",
          "nullable": true,
          "comment": "DATETIME 成员 UTC 微秒值；仅该类型非空。"
        },
        {
          "name": "duration_value",
          "type": "BIGINT",
          "nullable": true,
          "comment": "DURATION 成员非负毫秒值；仅该类型非空。"
        },
        {
          "name": "display_name",
          "type": "VARCHAR(255)",
          "nullable": true,
          "comment": "成员的可选展示名称，不改变成员业务值；未填写时为空。"
        },
        {
          "name": "sort_order",
          "type": "INT",
          "nullable": false,
          "comment": "成员在管理与选项中的展示顺序，正整数；不参与集合包含判断。"
        },
        {
          "name": "create_time",
          "type": "DATETIME(6)",
          "nullable": false,
          "comment": "该成员行在 Risk 数据库中的 UTC 微秒写入时间。"
        }
      ],
      "indexes": [
        {
          "name": "PRIMARY",
          "columns": [
            "member_id"
          ],
          "kind": "PRIMARY",
          "comment": "成员行标识"
        },
        {
          "name": "uk_risk_variable_member",
          "columns": [
            "variable_code",
            "value_key"
          ],
          "kind": "UNIQUE",
          "comment": "保证同一集合的规范值唯一"
        },
        {
          "name": "idx_risk_variable_member_order",
          "columns": [
            "variable_code",
            "sort_order",
            "member_id"
          ],
          "kind": "INDEX",
          "comment": "支持集合成员稳定分页和展示"
        }
      ]
    }
  ],
