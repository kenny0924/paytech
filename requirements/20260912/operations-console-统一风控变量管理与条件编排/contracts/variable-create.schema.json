{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VariableCreate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variableCode",
    "variableName",
    "description",
    "sourceType",
    "valueType",
    "pointCode",
    "sourceContractCode",
    "sourceContractVersion",
    "sourceField",
    "usages",
    "formatCode",
    "numericUnit",
    "currencyCode",
    "currencyVariableCode",
    "allowedValuesVariableCode",
    "currentValue",
    "status"
  ],
  "properties": {
    "variableCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "variableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceType": {
      "enum": [
        "INPUT",
        "CONSTANT",
        "COLLECTION"
      ]
    },
    "valueType": {
      "enum": [
        "STRING",
        "NUMBER",
        "BOOLEAN",
        "DATETIME",
        "DURATION"
      ]
    },
    "pointCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceContractCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceContractVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceField": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "usages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "RULE_CONDITION",
          "FLOW_CONDITION",
          "ACTION_PARAMETER"
        ]
      }
    },
    "formatCode": {
      "enum": [
        "TEXT",
        "TOKEN",
        "UPPER_ALPHA_2",
        "UPPER_ALPHA_3",
        "DIGITS_4",
        "BCP47",
        "POSITIVE_ID",
        "NONE"
      ]
    },
    "numericUnit": {
      "enum": [
        "SCALAR",
        "MONEY",
        null
      ]
    },
    "currencyCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currencyVariableCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowedValuesVariableCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentValue": {
      "type": [
        "string",
        "boolean",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "INPUT"
          }
        }
      },
      "then": {
        "properties": {
          "pointCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "sourceContractCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "sourceContractVersion": {
            "type": "integer",
            "minimum": 1
          },
          "sourceField": {
            "type": "string"
          },
          "currentValue": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "sourceContractCode": {
            "type": "null"
          },
          "sourceContractVersion": {
            "type": "null"
          },
          "sourceField": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "COLLECTION"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "null"
          },
          "allowedValuesVariableCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          },
          "valueType": {
            "const": "STRING"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          },
          "valueType": {
            "const": "NUMBER"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,8})?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          },
          "valueType": {
            "const": "BOOLEAN"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          },
          "valueType": {
            "const": "DATETIME"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "CONSTANT"
          },
          "valueType": {
            "const": "DURATION"
          }
        }
      },
      "then": {
        "properties": {
          "currentValue": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "valueType": {
            "const": "NUMBER"
          }
        }
      },
      "then": {
        "properties": {
          "formatCode": {
            "const": "NONE"
          },
          "numericUnit": {
            "enum": [
              "SCALAR",
              "MONEY"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "numericUnit": {
                  "const": "SCALAR"
                }
              }
            },
            "then": {
              "properties": {
                "currencyCode": {
                  "type": "null"
                },
                "currencyVariableCode": {
                  "type": "null"
                }
              }
            },
            "else": {
              "oneOf": [
                {
                  "properties": {
                    "currencyCode": {
                      "type": "string"
                    },
                    "currencyVariableCode": {
                      "type": "null"
                    }
                  }
                },
                {
                  "properties": {
                    "currencyCode": {
                      "type": "null"
                    },
                    "currencyVariableCode": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "else": {
        "properties": {
          "numericUnit": {
            "type": "null"
          },
          "currencyCode": {
            "type": "null"
          },
          "currencyVariableCode": {
            "type": "null"
          }
        }
      }
    }
  ]
}
