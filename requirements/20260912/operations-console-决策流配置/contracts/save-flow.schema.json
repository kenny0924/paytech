{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risk 决策流完整保存请求（阶段3评审）",
  "description": "只描述完整保存结构；图拓扑、条件类型、引用资格、BigInt范围与 UTF-8 总字节必须由 Risk 另行验证。N04 使用去除完整配置矩阵的形状校验以报告未完成节点。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pointCode",
    "flowCode",
    "flowName",
    "baseFlowVersionId",
    "expectedVersion",
    "changeReason",
    "graph"
  ],
  "properties": {
    "pointCode": {
      "const": "CHECKOUT_PREPARE"
    },
    "flowCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "flowName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "baseFlowVersionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "服务端另校验不超过正 BIGINT 上界"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedVersion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "服务端另校验不超过正 BIGINT 上界"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "graph": {
      "$ref": "#/$defs/Graph"
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKey",
        "type",
        "name",
        "position",
        "ruleSetVersionId",
        "decisionCode",
        "reasonCode",
        "reasonMessage"
      ],
      "properties": {
        "nodeKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "START",
            "RULE_SET",
            "END"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,4}|-?100000)$"
            },
            "y": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,4}|-?100000)$"
            }
          }
        },
        "ruleSetVersionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "服务端另校验不超过正 BIGINT 上界"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionCode": {
          "anyOf": [
            {
              "enum": [
                "ALLOW",
                "REVIEW",
                "DENY"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonMessage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "START"
              }
            }
          },
          "then": {
            "properties": {
              "ruleSetVersionId": {
                "type": "null"
              },
              "decisionCode": {
                "type": "null"
              },
              "reasonCode": {
                "type": "null"
              },
              "reasonMessage": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "RULE_SET"
              }
            }
          },
          "then": {
            "properties": {
              "ruleSetVersionId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "服务端另校验不超过正 BIGINT 上界"
              },
              "decisionCode": {
                "type": "null"
              },
              "reasonCode": {
                "type": "null"
              },
              "reasonMessage": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "END"
              }
            }
          },
          "then": {
            "properties": {
              "ruleSetVersionId": {
                "type": "null"
              },
              "decisionCode": {
                "enum": [
                  "ALLOW",
                  "REVIEW",
                  "DENY"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decisionCode": {
                "const": "DENY"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "reasonMessage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "else": {
            "properties": {
              "reasonCode": {
                "type": "null"
              },
              "reasonMessage": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeKey",
        "sourceNodeKey",
        "targetNodeKey",
        "type",
        "priority",
        "name",
        "condition"
      ],
      "properties": {
        "edgeKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "sourceNodeKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "targetNodeKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "UNCONDITIONAL",
            "CONDITIONAL",
            "ELSE"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "CONDITIONAL"
              }
            }
          },
          "then": {
            "properties": {
              "priority": {
                "minimum": 1
              },
              "condition": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "else": {
            "properties": {
              "priority": {
                "const": 0
              },
              "condition": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "nodes",
        "edges"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        }
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "root"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "root": {
          "$ref": "#/$defs/Expression"
        }
      }
    },
    "Expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operator",
            "children"
          ],
          "properties": {
            "kind": {
              "const": "GROUP"
            },
            "operator": {
              "enum": [
                "AND",
                "OR",
                "NOT"
              ]
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/Expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "operator",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "PREDICATE"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "fieldCode"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "CONTEXT",
                    "NODE_RESULT"
                  ]
                },
                "fieldCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "operator": {
              "enum": [
                "EQ",
                "NE",
                "GT",
                "GTE",
                "LT",
                "LTE",
                "BETWEEN",
                "IN",
                "NOT_IN",
                "IS_NULL",
                "IS_NOT_NULL"
              ]
            },
            "values": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": [
                  "string",
                  "boolean"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "baseFlowVersionId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "expectedVersion": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "expectedVersion": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "服务端另校验不超过正 BIGINT 上界"
          }
        }
      }
    }
  ]
}
