  "scope": "Optimizer access paths with synthetic rows in one rolled-back transaction; not a load or latency benchmark. Credential and Route projections/joins read from current production mapper SQL fragments.",
  "queries": {
    "scope_exact": "SELECT api_scope_id,scope_code,display_name,description,version,create_time,update_time FROM t_api_scope WHERE scope_code='explain0927f24e8b06.s000' AND BINARY scope_code=BINARY 'explain0927f24e8b06.s000'",
    "credential_reference_page": "SELECT c.credential_id credentialId,c.tenant_id tenantId,t.tenant_type tenantType,t.owner_ref_id clientId,\n        t.tenant_name clientName,c.key_prefix keyPrefix,c.status storedStatus,t.owner_status tenantOwnerStatus,\n        t.security_status tenantSecurityStatus,c.expires_time expiresTime,c.rotated_from_id rotatedFromId,\n        c.version,c.create_time createTime,c.update_time updateTime FROM t_api_credential c LEFT JOIN t_access_tenant t ON t.tenant_id=c.tenant_id WHERE (t.tenant_type='CLIENT' OR t.tenant_id IS NULL) AND EXISTS(SELECT 1 FROM t_api_credential_scope g WHERE g.credential_id=c.credential_id AND g.scope_code='explain0927f24e8b06.s000' AND BINARY g.scope_code=BINARY 'explain0927f24e8b06.s000') ORDER BY c.credential_id LIMIT 20 OFFSET 0",
    "credential_reference_count": "SELECT COUNT(*) FROM t_api_credential c LEFT JOIN t_access_tenant t ON t.tenant_id=c.tenant_id WHERE (t.tenant_type='CLIENT' OR t.tenant_id IS NULL) AND EXISTS(SELECT 1 FROM t_api_credential_scope g WHERE g.credential_id=c.credential_id AND g.scope_code='explain0927f24e8b06.s000' AND BINARY g.scope_code=BINARY 'explain0927f24e8b06.s000')",
    "route_reference_page": "SELECT r.route_id routeId, r.route_code routeCode, r.channel, r.http_method httpMethod,\n        r.external_path_template externalPathTemplate, r.downstream_path_template downstreamPathTemplate,\n        r.target_id targetId, t.target_service_code targetServiceCode, t.status targetStatus,\n        r.security_profile_code securityProfileCode, r.authorization_mode authorizationMode,\n        r.permission_id permissionId, p.permission_code permissionCode, r.required_scope_code requiredScopeCode,\n        r.request_cookie_mode requestCookieMode, r.response_cookie_mode responseCookieMode,\n        r.body_limit_bytes bodyLimitBytes, r.body_receive_timeout_millis bodyReceiveTimeoutMillis,\n        r.response_timeout_millis responseTimeoutMillis, r.status, r.version, r.created_by createdBy,\n        r.updated_by updatedBy, r.create_time createTime, r.update_time updateTime FROM t_gateway_route r\n        JOIN t_gateway_target t ON t.target_id=r.target_id AND t.channel=r.channel\n        LEFT JOIN t_permission p ON p.permission_id=r.permission_id WHERE r.required_scope_code='explain0927f24e8b06.s000' AND BINARY r.required_scope_code=BINARY 'explain0927f24e8b06.s000' ORDER BY r.route_code,r.route_id LIMIT 20 OFFSET 0",
    "route_reference_count": "SELECT COUNT(*) FROM t_gateway_route r\n        JOIN t_gateway_target t ON t.target_id=r.target_id AND t.channel=r.channel\n        LEFT JOIN t_permission p ON p.permission_id=r.permission_id WHERE r.required_scope_code='explain0927f24e8b06.s000' AND BINARY r.required_scope_code=BINARY 'explain0927f24e8b06.s000'"
  },
