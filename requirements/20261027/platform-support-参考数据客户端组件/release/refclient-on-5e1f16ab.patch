+            MccResponseBody body = new MccResponseBody();
+            body.setMccCode(code);
+            body.setName("Test MCC " + code);
+            body.setDescription("Test MCC " + code);
+            body.setNetworkHighRisk(networkHighRisk);
+            body.setStatus(status);
+            body.setVersion(1);
+            return body;
+        }
+    }
+}
