diff --git a/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientAutoConfiguration.java b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientAutoConfiguration.java
new file mode 100644
index 00000000..aa7c447e
--- /dev/null
+++ b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientAutoConfiguration.java
@@ -0,0 +1,152 @@
+package com.paytech.platform.support.referencedata.client.autoconfigure;
+
+import java.net.http.HttpClient;
+
+import org.springframework.beans.factory.BeanFactory;
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.boot.autoconfigure.AutoConfiguration;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
+import org.springframework.boot.context.properties.EnableConfigurationProperties;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.env.Environment;
+import org.springframework.http.client.JdkClientHttpRequestFactory;
+import org.springframework.http.converter.json.JacksonJsonHttpMessageConverter;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.service.invoker.HttpServiceProxyFactory;
+
+import com.paytech.foundation.httpclient.api.HttpServiceClientFactory;
+import com.paytech.foundation.httpclient.api.HttpServiceClientOptions;
+import com.paytech.foundation.internalauth.api.InternalTokenSupplier;
+import com.paytech.platform.support.api.referencedata.CountrySubdivisionQueryApi;
+import com.paytech.platform.support.api.referencedata.IndustryQueryApi;
+import com.paytech.platform.support.api.referencedata.MccQueryApi;
+import com.paytech.platform.support.api.referencedata.ReferenceCountryQueryApi;
+import com.paytech.platform.support.api.referencedata.ReferenceCurrencyQueryApi;
+import com.paytech.platform.support.referencedata.client.ReferenceData;
+import com.paytech.platform.support.referencedata.client.ReferenceDataRefresher;
+import com.paytech.platform.support.referencedata.client.internal.BoundedResponseInterceptor;
+import com.paytech.platform.support.referencedata.client.internal.LoadBalancedPlatformTarget;
+import com.paytech.platform.support.referencedata.client.internal.PlatformReferenceDataLoader;
+import com.paytech.platform.support.referencedata.client.internal.ReferenceDataHealthIndicator;
+import com.paytech.platform.support.referencedata.client.internal.ReferenceDataRefreshScheduler;
+import com.paytech.platform.support.referencedata.client.internal.ReferenceDataSnapshot;
+
+import tools.jackson.databind.DeserializationFeature;
+import tools.jackson.databind.json.JsonMapper;
+
+/**
+ * 参考数据客户端装配：
+ * <li>目标：配置 base-url 时直连；否则经宿主 LoadBalancerClient 按 service-id + context-path 访问（没有时启动失败）。</li>
+ * <li>每个请求带 {@code X-Caller-Service}（caller-service，默认 spring.application.name），供 Platform internal-auth DUAL 识别调用服务。</li>
+ * <li>组件：快照、刷新入口与自带调度、健康指标 {@code referenceData}，以及只供本客户端使用的 Platform HTTP 代理。</li>
+ * <li>HTTP 客户端自建，不与宿主的 {@code platform-support-service} 组共用：宽松 JSON（忽略 Platform 追加的字段），响应上限 1 MiB，
+ * 不自动重试、不跟随重定向；错误按 Foundation 公共出站边界（RFC 9457 Problem）转换。</li>
+ * <li>宿主引入 {@code paytech-internal-auth} 且存在 {@link InternalTokenSupplier} Bean 时，附加目标为 service-id（默认
+ * {@code platform-support-service}）的内部调用 Token，与 X-Caller-Service 同时发送；否则只发送 X-Caller-Service。</li>
+ */
+@AutoConfiguration(afterName = "org.springframework.cloud.loadbalancer.config.BlockingLoadBalancerClientAutoConfiguration")
+@EnableConfigurationProperties(ReferenceDataClientProperties.class)
+public class ReferenceDataClientAutoConfiguration {
+
+    /** 调用服务请求头。 */
+    static final String CALLER_SERVICE_HEADER = "X-Caller-Service";
+
+    /** 已开启种类的进程内快照，即消费方注入的 {@link ReferenceData}。 */
+    @Bean
+    ReferenceDataSnapshot referenceDataSnapshot(ReferenceDataClientProperties properties) {
+        return new ReferenceDataSnapshot(properties.kinds());
+    }
+
+    /** 刷新入口与自带调度；随应用上下文启动和关闭。 */
+    @Bean
+    ReferenceDataRefreshScheduler referenceDataRefresher(ReferenceDataSnapshot snapshot,
+        PlatformReferenceDataLoader referenceDataLoader, ReferenceDataClientProperties properties) {
+        return new ReferenceDataRefreshScheduler(snapshot, referenceDataLoader, properties.schedulingEnabled(),
+            properties.refreshInterval(), properties.initialRetryInterval());
+    }
+
+    /** 健康指标，Bean 名即健康组件名 {@code referenceData}。 */
+    @Bean
+    ReferenceDataHealthIndicator referenceData(ReferenceDataSnapshot snapshot) {
+        return new ReferenceDataHealthIndicator(snapshot);
+    }
+
+    /** Platform 五个只读查询接口的代理，只供刷新入口使用。 */
+    @Bean
+    PlatformReferenceDataLoader referenceDataLoader(ReferenceDataClientProperties properties, Environment environment,
+        BeanFactory beanFactory, ObjectProvider<ReferenceDataHttpOptions> httpOptions) {
+        HttpServiceClientOptions options = HttpServiceClientOptions.strict();
+        ReferenceDataHttpOptions customizer = httpOptions.getIfAvailable();
+        RestClient.Builder builder = baseBuilder(properties, resolveCaller(properties, environment));
+        if (properties.baseUrl() == null) {
+            builder.baseUrl(properties.discoveryBaseUrl())
+                .requestInterceptor(LoadBalancedPlatformTarget.interceptor(beanFactory, properties.serviceId()));
+        } else {
+            builder.baseUrl(properties.baseUrl());
+        }
+        HttpServiceProxyFactory factory = HttpServiceClientFactory.create(builder.build(),
+            customizer == null ? options : customizer.customize(options, properties.serviceId()));
+        return new PlatformReferenceDataLoader(factory.createClient(ReferenceCurrencyQueryApi.class),
+            factory.createClient(ReferenceCountryQueryApi.class), factory.createClient(CountrySubdivisionQueryApi.class),
+            factory.createClient(IndustryQueryApi.class), factory.createClient(MccQueryApi.class));
+    }
+
+    /** 调用服务名：caller-service，未配置时取 spring.application.name；都没有时启动失败。 */
+    private static String resolveCaller(ReferenceDataClientProperties properties, Environment environment) {
+        String caller = properties.callerService() != null ? properties.callerService()
+            : environment.getProperty("spring.application.name");
+        if (caller == null) {
+            throw new IllegalStateException("参考数据客户端缺少调用服务名：请配置 platform-support.reference-data.client.caller-service "
+                + "或 spring.application.name");
+        }
+        ReferenceDataClientProperties.requireServiceName("caller-service", caller);
+        return caller;
+    }
+
+    /**
+     * 本客户端专用的 RestClient Builder（目标地址由调用方设置）
+     * <li>{@code HttpServiceClientOptions.strict()} 只表示严格的 Problem 错误解码；未调用 withStrictJsonResponses，因此成功响应使用下列宽松
+     * JsonMapper，未知字段被忽略。</li>
+     */
+    private static RestClient.Builder baseBuilder(ReferenceDataClientProperties properties, String caller) {
+        HttpClient transport = HttpClient.newBuilder().connectTimeout(properties.connectTimeout())
+            .followRedirects(HttpClient.Redirect.NEVER).build();
+        var requestFactory = new JdkClientHttpRequestFactory(transport);
+        requestFactory.setReadTimeout(properties.readTimeout());
+        JsonMapper json = JsonMapper.builder().disable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES).build();
+        return RestClient.builder().requestFactory(requestFactory).defaultHeader(CALLER_SERVICE_HEADER, caller)
+            .requestInterceptor(new BoundedResponseInterceptor())
+            .configureMessageConverters(converters -> converters.disableDefaults()
+                .withJsonConverter(new JacksonJsonHttpMessageConverter(json)));
+    }
+
+    /** 调整本客户端的 HTTP 选项（内部调用 Token）。 */
+    @FunctionalInterface
+    interface ReferenceDataHttpOptions {
+
+        /**
+         * 在基础选项上附加宿主能力
+         *
+         * @param options 基础选项
+         * @param targetService Platform 服务发现名（Token {@code aud}）
+         * @return 调整后的选项
+         */
+        HttpServiceClientOptions customize(HttpServiceClientOptions options, String targetService);
+    }
+
+    /** 仅当宿主引入 {@code paytech-internal-auth} 时加载；没有 Supplier Bean 时选项不变。 */
+    @Configuration(proxyBeanMethods = false)
+    @ConditionalOnClass(name = "com.paytech.foundation.internalauth.api.InternalTokenSupplier")
+    static class InternalTokenConfiguration {
+
+        /** 存在 {@link InternalTokenSupplier} 时为 Platform 请求附加内部调用 Token。 */
+        @Bean
+        ReferenceDataHttpOptions referenceDataInternalToken(ObjectProvider<InternalTokenSupplier> tokens) {
+            return (options, targetService) -> {
+                InternalTokenSupplier supplier = tokens.getIfAvailable();
+                return supplier == null ? options : options.withInternalToken(supplier, targetService);
+            };
+        }
+    }
+}
diff --git a/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientProperties.java b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientProperties.java
new file mode 100644
index 00000000..e40f77f9
--- /dev/null
+++ b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/autoconfigure/ReferenceDataClientProperties.java
@@ -0,0 +1,118 @@
+package com.paytech.platform.support.referencedata.client.autoconfigure;
+
+import java.net.URI;
+import java.time.Duration;
+import java.util.EnumSet;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+
+import com.paytech.platform.support.referencedata.client.ReferenceDataKind;
+
+/**
+ * 参考数据客户端配置；不合法时启动失败。
+ * <li>宽松 JSON、响应上限 1 MiB、不自动重试、不跟随重定向是固定行为，不开放配置。</li>
+ *
+ * @param baseUrl 可选：Platform 直连基址（含 Context Path），如 {@code http://127.0.0.1:18106/platform-support}，用于自动测试与本机；
+ *            配置后不使用服务发现。未配置时经 LoadBalancerClient 按 serviceId + contextPath 访问
+ * @param serviceId 未配置 baseUrl 时的服务发现名，默认 platform-support-service
+ * @param contextPath 未配置 baseUrl 时 Platform 的 Context Path，默认 /platform-support；以 / 开头、不以 / 结尾，或为空
+ * @param callerService 请求头 X-Caller-Service 的值（Platform internal-auth DUAL 据此识别调用服务）；未配置时取
+ *            spring.application.name，两者都没有时启动失败
+ * @param kinds 必填，至少一项：要加载的种类 CURRENCY / COUNTRY / SUBDIVISION / INDUSTRY / MCC；未开启的种类读取时报"未配置"
+ * @param refreshInterval 首次全部加载成功后的全量刷新间隔，默认 PT1H，不小于 1 分钟；Platform 的变更最迟一个间隔后生效
+ * @param initialRetryInterval 首次全部加载成功前，未成功种类的重试间隔，默认 PT10S，不小于 1 秒
+ * @param schedulingEnabled 是否启动自带调度，默认 true；自动测试设为 false，经 ReferenceDataRefresher.refreshNow() 加载
+ * @param connectTimeout 连接超时，默认 2 秒，大于零
+ * @param readTimeout 读取超时，默认 5 秒，大于零
+ */
+@ConfigurationProperties("platform-support.reference-data.client")
+public record ReferenceDataClientProperties(String baseUrl, @DefaultValue("platform-support-service") String serviceId,
+    @DefaultValue("/platform-support") String contextPath, String callerService, Set<ReferenceDataKind> kinds,
+    @DefaultValue("PT1H") Duration refreshInterval, @DefaultValue("PT10S") Duration initialRetryInterval,
+    @DefaultValue("true") boolean schedulingEnabled, @DefaultValue("2s") Duration connectTimeout,
+    @DefaultValue("5s") Duration readTimeout) {
+
+    private static final Duration MIN_REFRESH_INTERVAL = Duration.ofMinutes(1);
+
+    private static final Duration MIN_INITIAL_RETRY_INTERVAL = Duration.ofSeconds(1);
+
+    /** 服务名格式（服务发现名与调用服务名）。 */
+    private static final Pattern SERVICE_NAME = Pattern.compile("[a-z][a-z0-9-]{0,127}");
+
+    /** Context Path 格式：为空，或以 / 开头的路径段且不以 / 结尾。 */
+    private static final Pattern CONTEXT_PATH = Pattern.compile("(/[A-Za-z0-9._~-]+)*");
+
+    /** 校验必填项与下限，并冻结种类集合。 */
+    public ReferenceDataClientProperties {
+        if (baseUrl != null) {
+            validateBaseUrl(baseUrl);
+        }
+        requireServiceName("service-id", serviceId);
+        if (contextPath == null || !CONTEXT_PATH.matcher(contextPath).matches()) {
+            throw new IllegalArgumentException("platform-support.reference-data.client.context-path 必须为空或以 / 开头且不以 / 结尾");
+        }
+        if (callerService != null) {
+            requireServiceName("caller-service", callerService);
+        }
+        if (kinds == null || kinds.isEmpty()) {
+            throw new IllegalArgumentException("platform-support.reference-data.client.kinds 必须至少开启一个种类");
+        }
+        kinds = Set.copyOf(EnumSet.copyOf(kinds));
+        requireAtLeast("refresh-interval", refreshInterval, MIN_REFRESH_INTERVAL);
+        requireAtLeast("initial-retry-interval", initialRetryInterval, MIN_INITIAL_RETRY_INTERVAL);
+        requirePositive("connect-timeout", connectTimeout);
+        requirePositive("read-timeout", readTimeout);
+    }
+
+    /**
+     * 未配置 base-url 时经服务发现访问的根地址（服务名作主机，由 LoadBalancerInterceptor 解析为实例）
+     *
+     * @return {@code http://<serviceId><contextPath>}
+     */
+    public String discoveryBaseUrl() {
+        return "http://" + serviceId + contextPath;
+    }
+
+    /** 服务名必填且为小写服务名格式。 */
+    static void requireServiceName(String name, String value) {
+        if (value == null || !SERVICE_NAME.matcher(value).matches()) {
+            throw new IllegalArgumentException("platform-support.reference-data.client." + name + " 必须是小写服务名: " + value);
+        }
+    }
+
+    /** base-url 必须是带主机的 http / https 地址，不含用户信息、查询或片段。 */
+    private static void validateBaseUrl(String baseUrl) {
+        if (baseUrl.isBlank()) {
+            throw new IllegalArgumentException("platform-support.reference-data.client.base-url 配置时不能为空白");
+        }
+        URI uri;
+        try {
+            uri = URI.create(baseUrl);
+        } catch (IllegalArgumentException invalid) {
+            throw new IllegalArgumentException("platform-support.reference-data.client.base-url 格式非法", invalid);
+        }
+        boolean http = "http".equals(uri.getScheme()) || "https".equals(uri.getScheme());
+        if (!http || uri.getHost() == null || uri.getUserInfo() != null || uri.getRawQuery() != null
+            || uri.getRawFragment() != null) {
+            throw new IllegalArgumentException("platform-support.reference-data.client.base-url 必须是不带用户信息、查询和片段的 "
+                + "http(s) 地址");
+        }
+    }
+
+    /** 时长必填且不小于下限。 */
+    private static void requireAtLeast(String name, Duration value, Duration minimum) {
+        if (value == null || value.compareTo(minimum) < 0) {
+            throw new IllegalArgumentException("platform-support.reference-data.client." + name + " 不能小于 " + minimum);
+        }
+    }
+
+    /** 时长必填且大于零。 */
+    private static void requirePositive(String name, Duration value) {
+        if (value == null || value.isZero() || value.isNegative()) {
+            throw new IllegalArgumentException("platform-support.reference-data.client." + name + " 必须大于零");
+        }
+    }
+}
diff --git a/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/BoundedResponseInterceptor.java b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/BoundedResponseInterceptor.java
new file mode 100644
index 00000000..b007edeb
--- /dev/null
+++ b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/BoundedResponseInterceptor.java
@@ -0,0 +1,74 @@
+package com.paytech.platform.support.referencedata.client.internal;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpRequest;
+import org.springframework.http.HttpStatusCode;
+import org.springframework.http.client.ClientHttpRequestExecution;
+import org.springframework.http.client.ClientHttpRequestInterceptor;
+import org.springframework.http.client.ClientHttpResponse;
+
+import com.paytech.foundation.common.error.CommonErrorCode;
+import com.paytech.foundation.common.error.ErrorException;
+
+/**
+ * 限制单个响应体的字节数（1 MiB）：Foundation 只在严格 JSON 模式下限制响应大小，本客户端使用宽松 JSON，因此在此单独设上限。
+ * <li>超过上限抛 UPSTREAM_INVALID_RESPONSE，该种类本次刷新失败。</li>
+ */
+public final class BoundedResponseInterceptor implements ClientHttpRequestInterceptor {
+
+    /** 响应体上限（字节）。 */
+    public static final int MAXIMUM_RESPONSE_BYTES = 1024 * 1024;
+
+    /** 读取有界正文后关闭网络响应，返回内存副本。 */
+    @Override
+    public ClientHttpResponse intercept(HttpRequest request, byte[] body, ClientHttpRequestExecution execution)
+        throws IOException {
+        try (ClientHttpResponse response = execution.execute(request, body)) {
+            byte[] bytes = response.getBody().readNBytes(MAXIMUM_RESPONSE_BYTES + 1);
+            if (bytes.length > MAXIMUM_RESPONSE_BYTES) {
+                throw new ErrorException(CommonErrorCode.UPSTREAM_INVALID_RESPONSE,
+                    "Platform 参考数据响应超过 " + MAXIMUM_RESPONSE_BYTES + " 字节");
+            }
+            return new BufferedResponse(response.getStatusCode(), response.getStatusText(), response.getHeaders(), bytes);
+        }
+    }
+
+    /** 已读入内存的响应。 */
+    private record BufferedResponse(HttpStatusCode status, String statusText, HttpHeaders headers, byte[] body)
+        implements ClientHttpResponse {
+
+        /** 原状态码。 */
+        @Override
+        public HttpStatusCode getStatusCode() {
+            return status;
+        }
+
+        /** 原状态文本。 */
+        @Override
+        public String getStatusText() {
+            return statusText;
+        }
+
+        /** 原响应头。 */
+        @Override
+        public HttpHeaders getHeaders() {
+            return headers;
+        }
+
+        /** 内存正文。 */
+        @Override
+        public InputStream getBody() {
+            return new ByteArrayInputStream(body);
+        }
+
+        /** 网络响应已在读取后关闭。 */
+        @Override
+        public void close() {
+            // 无需释放资源。
+        }
+    }
+}
diff --git a/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/LoadBalancedPlatformTarget.java b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/LoadBalancedPlatformTarget.java
new file mode 100644
index 00000000..6288a527
--- /dev/null
+++ b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/LoadBalancedPlatformTarget.java
@@ -0,0 +1,53 @@
+package com.paytech.platform.support.referencedata.client.internal;
+
+import org.springframework.beans.factory.BeanFactory;
+import org.springframework.cloud.client.loadbalancer.LoadBalancerClient;
+import org.springframework.cloud.client.loadbalancer.LoadBalancerInterceptor;
+import org.springframework.http.client.ClientHttpRequestInterceptor;
+import org.springframework.util.ClassUtils;
+
+/**
+ * 未配置 base-url 时的服务发现目标：用宿主的 LoadBalancerClient 把 {@code http://<serviceId>/...} 解析为实例。
+ * <li>只在 spring-cloud-commons 位于 classpath 时加载 LoadBalancer 类型；缺少类或 Bean 时启动失败并说明原因。</li>
+ */
+public final class LoadBalancedPlatformTarget {
+
+    private static final String LOAD_BALANCER_CLIENT = "org.springframework.cloud.client.loadbalancer.LoadBalancerClient";
+
+    private LoadBalancedPlatformTarget() {
+    }
+
+    /**
+     * 创建按服务名选择实例的拦截器
+     *
+     * @param beanFactory 宿主容器
+     * @param serviceId 服务发现名（用于错误说明）
+     * @return LoadBalancer 拦截器
+     * @throws IllegalStateException classpath 或容器中没有 LoadBalancerClient
+     */
+    public static ClientHttpRequestInterceptor interceptor(BeanFactory beanFactory, String serviceId) {
+        if (!ClassUtils.isPresent(LOAD_BALANCER_CLIENT, LoadBalancedPlatformTarget.class.getClassLoader())) {
+            throw missingLoadBalancer(serviceId);
+        }
+        return Discovery.interceptor(beanFactory, serviceId);
+    }
+
+    /** 未配置直连地址又无法服务发现。 */
+    private static IllegalStateException missingLoadBalancer(String serviceId) {
+        return new IllegalStateException("参考数据客户端未配置 platform-support.reference-data.client.base-url，需要经服务发现访问 "
+            + serviceId + "，但宿主没有 LoadBalancerClient：请引入 spring-cloud-starter-loadbalancer 与服务发现，或配置 base-url 直连");
+    }
+
+    /** 引用 LoadBalancer 类型的部分，只在类存在时加载。 */
+    private static final class Discovery {
+
+        /** 取宿主 LoadBalancerClient 并包装为拦截器。 */
+        private static ClientHttpRequestInterceptor interceptor(BeanFactory beanFactory, String serviceId) {
+            LoadBalancerClient client = beanFactory.getBeanProvider(LoadBalancerClient.class).getIfAvailable();
+            if (client == null) {
+                throw missingLoadBalancer(serviceId);
+            }
+            return new LoadBalancerInterceptor(client);
+        }
+    }
+}
diff --git a/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/PlatformReferenceDataLoader.java b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/PlatformReferenceDataLoader.java
new file mode 100644
index 00000000..2438bfa8
--- /dev/null
+++ b/paytech/platform-support/paytech-platform-support-reference-data-client/src/main/java/com/paytech/platform/support/referencedata/client/internal/PlatformReferenceDataLoader.java
@@ -0,0 +1,284 @@
+package com.paytech.platform.support.referencedata.client.internal;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.regex.Pattern;
+
+import com.paytech.foundation.common.enums.CodeEnum;
+import com.paytech.foundation.common.error.CommonErrorCode;
+import com.paytech.foundation.common.error.ErrorException;
+import com.paytech.foundation.web.paging.PagingResponseBody;
+import com.paytech.platform.support.api.enums.CurrencyRoundingMode;
+import com.paytech.platform.support.api.enums.ReferenceDataStatus;
+import com.paytech.platform.support.api.referencedata.CountrySubdivisionQueryApi;
+import com.paytech.platform.support.api.referencedata.IndustryQueryApi;
+import com.paytech.platform.support.api.referencedata.MccQueryApi;
+import com.paytech.platform.support.api.referencedata.ReferenceCountryQueryApi;
+import com.paytech.platform.support.api.referencedata.ReferenceCurrencyQueryApi;
+import com.paytech.platform.support.api.referencedata.response.CountrySubdivisionResponseBody;
+import com.paytech.platform.support.api.referencedata.response.IndustryResponseBody;
+import com.paytech.platform.support.api.referencedata.response.MccResponseBody;
+import com.paytech.platform.support.api.referencedata.response.ReferenceCountryResponseBody;
+import com.paytech.platform.support.api.referencedata.response.ReferenceCurrencyResponseBody;
+import com.paytech.platform.support.referencedata.client.ReferenceCountry;
+import com.paytech.platform.support.referencedata.client.ReferenceCurrency;
+import com.paytech.platform.support.referencedata.client.ReferenceDataKind;
+import com.paytech.platform.support.referencedata.client.ReferenceIndustry;
+import com.paytech.platform.support.referencedata.client.ReferenceItem;
+import com.paytech.platform.support.referencedata.client.ReferenceMcc;
+import com.paytech.platform.support.referencedata.client.ReferenceSubdivision;
+
+/**
+ * 从 Platform {@code /platform/v1/reference-data/*} 全量拉取一个种类，逐条校验并转换为值对象。
+ * <li>任一条不合法（编码为空或格式非法、编码重复、状态或舍入方式无法识别、币种小数位越界、MCC 翻页总数不符）时整个种类本次失败，
+ * 避免把半份数据装入快照；失败抛 UPSTREAM_INVALID_RESPONSE 系统异常，由刷新入口记录并保留旧快照。</li>
+ * <li>只读取本客户端定义的字段，Platform 追加字段由宽松 JSON 忽略。</li>
+ */
+public final class PlatformReferenceDataLoader {
+
+    /** MCC 全量加载的每页条数（Platform 允许的最大值）。 */
+    static final int MCC_PAGE_SIZE = 200;
+
+    private static final Pattern CURRENCY_CODE = Pattern.compile("[A-Z]{3}");
+
+    private static final Pattern COUNTRY_CODE = Pattern.compile("[A-Z]{2}");
+
+    private static final Pattern NUMERIC_CODE = Pattern.compile("[0-9]{3}");
+
+    private static final Pattern SUBDIVISION_CODE = Pattern.compile("[A-Z]{2}-[A-Z0-9]{1,3}");
+
+    private static final Pattern INDUSTRY_CODE = Pattern.compile("[A-Z][A-Z0-9_]{0,63}");
+
+    private static final Pattern MCC_CODE = Pattern.compile("[0-9]{4}");
+
+    /** 开放集合的文本编码（区域、行政区类别）：大写字母、数字与下划线。 */
+    private static final Pattern OPEN_CODE = Pattern.compile("[A-Z][A-Z0-9_]{0,63}");
+
+    /** 币种小数位上限。 */
+    private static final int MAX_MINOR_UNIT = 8;
+
+    private final ReferenceCurrencyQueryApi currencyApi;
+
+    private final ReferenceCountryQueryApi countryApi;
+
+    private final CountrySubdivisionQueryApi subdivisionApi;
+
+    private final IndustryQueryApi industryApi;
+
+    private final MccQueryApi mccApi;
+
+    /**
+     * 使用 Platform 五个只读查询接口代理
+     *
+     * @param currencyApi 币种
+     * @param countryApi 国家
+     * @param subdivisionApi 行政区
+     * @param industryApi 行业
+     * @param mccApi MCC
+     */
+    public PlatformReferenceDataLoader(ReferenceCurrencyQueryApi currencyApi, ReferenceCountryQueryApi countryApi,
+        CountrySubdivisionQueryApi subdivisionApi, IndustryQueryApi industryApi, MccQueryApi mccApi) {
+        this.currencyApi = currencyApi;
+        this.countryApi = countryApi;
+        this.subdivisionApi = subdivisionApi;
+        this.industryApi = industryApi;
+        this.mccApi = mccApi;
+    }
+
+    /**
+     * 全量拉取并校验一个种类（发起 HTTP，只在刷新入口调用）
+     *
+     * @param kind 种类
+     * @return 该种类全部条目，编码唯一
+     */
+    public List<? extends ReferenceItem> load(ReferenceDataKind kind) {
+        return switch (kind) {
+            case CURRENCY -> convert(kind, requireItems(kind, currencyItems()), this::toCurrency);
+            case COUNTRY -> convert(kind, requireItems(kind, countryItems()), this::toCountry);
+            case SUBDIVISION -> convert(kind, requireItems(kind, subdivisionItems()), this::toSubdivision);
+            case INDUSTRY -> convert(kind, requireItems(kind, industryItems()), this::toIndustry);
+            case MCC -> convert(kind, loadAllMccs(), this::toMcc);
+        };
+    }
+
+    /** 全部状态的币种列表。 */
+    private List<ReferenceCurrencyResponseBody> currencyItems() {
+        var body = currencyApi.listCurrencies(null, null);
+        return body == null ? null : body.getItems();
+    }
+
+    /** 全部状态的国家列表。 */
+    private List<ReferenceCountryResponseBody> countryItems() {
+        var body = countryApi.listCountries(null, null);
+        return body == null ? null : body.getItems();
+    }
+
+    /** 全部国家、全部状态的行政区列表。 */
+    private List<CountrySubdivisionResponseBody> subdivisionItems() {
+        var body = subdivisionApi.listSubdivisions(null, null, null);
+        return body == null ? null : body.getItems();
+    }
+
+    /** 两级、全部状态的行业列表。 */
+    private List<IndustryResponseBody> industryItems() {
+        var body = industryApi.listIndustries(null, null, null, null);
+        return body == null ? null : body.getItems();
+    }
+
+    /**
+     * 按每页 200 条翻到最后一页，并核对总数
+     * <li>翻页过程中 total 变化、空页提前结束或最终条数不等于 total 时本次失败。</li>
+     */
+    List<MccResponseBody> loadAllMccs() {
+        List<MccResponseBody> items = new ArrayList<>();
+        long total = -1;
+        for (int page = 1; ; page++) {
+            PagingResponseBody<MccResponseBody> body = mccApi.searchMccs(null, null, null, page, MCC_PAGE_SIZE);
+            if (body == null) {
+                throw invalid(ReferenceDataKind.MCC, "第 " + page + " 页缺少响应体");
+            }
+            if (total >= 0 && body.total() != total) {
+                throw invalid(ReferenceDataKind.MCC, "翻页过程中总数变化 " + total + " -> " + body.total());
+            }
+            total = body.total();
+            items.addAll(body.items());
+            if (body.items().size() < MCC_PAGE_SIZE || items.size() >= total) {
+                break;
+            }
+        }
+        if (items.size() != total) {
+            throw invalid(ReferenceDataKind.MCC, "条数 " + items.size() + " 与总数 " + total + " 不一致");
+        }
+        return items;
+    }
+
+    /** 逐条转换并拒绝重复编码。 */
+    private static <D, T extends ReferenceItem> List<T> convert(ReferenceDataKind kind, List<D> items,
+        Function<D, T> converter) {
+        Set<String> codes = new HashSet<>();
+        List<T> converted = new ArrayList<>(items.size());
+        for (D item : items) {
+            if (item == null) {
+                throw invalid(kind, "存在空条目");
+            }
+            T value = converter.apply(item);
+            if (!codes.add(value.code())) {
+                throw invalid(kind, "编码重复 " + value.code());
+            }
+            converted.add(value);
+        }
+        return converted;
+    }
+
+    /** 列表响应必须有 items。 */
+    private static <D> List<D> requireItems(ReferenceDataKind kind, List<D> items) {
+        if (items == null) {
+            throw invalid(kind, "缺少 items");
+        }
+        return items;
+    }
+
+    /** 币种：代码、数字码、小数位 0..8、舍入方式与状态。 */
+    ReferenceCurrency toCurrency(ReferenceCurrencyResponseBody item) {
+        String code = requireCode(ReferenceDataKind.CURRENCY, item.getCurrencyCode(), CURRENCY_CODE);
+        Integer minorUnit = item.getMinorUnit();
+        if (minorUnit == null || minorUnit < 0 || minorUnit > MAX_MINOR_UNIT) {
+            throw invalid(ReferenceDataKind.CURRENCY, code + " 小数位越界 " + minorUnit);
+        }
+        return new ReferenceCurrency(code, requireField(ReferenceDataKind.CURRENCY, code, item.getNumericCode(),
+            NUMERIC_CODE), minorUnit, parse(ReferenceDataKind.CURRENCY, code, CurrencyRoundingMode.class,
+            item.getRoundingMode()), status(ReferenceDataKind.CURRENCY, code, item.getStatus()));
+    }
+
+    /** 国家：alpha-2 / alpha-3 / 数字码、区域、可选法定币种与状态。 */
+    ReferenceCountry toCountry(ReferenceCountryResponseBody item) {
+        ReferenceDataKind kind = ReferenceDataKind.COUNTRY;
+        String code = requireCode(kind, item.getCountryCode(), COUNTRY_CODE);
+        return new ReferenceCountry(code, requireField(kind, code, item.getAlpha3Code(), CURRENCY_CODE),
+            requireField(kind, code, item.getNumericCode(), NUMERIC_CODE),
+            requireField(kind, code, item.getRegionCode(), OPEN_CODE), item.getCallingCode(),
+            optionalField(kind, code, item.getDefaultCurrencyCode(), CURRENCY_CODE), status(kind, code, item.getStatus()));
+    }
+
+    /** 行政区：代码须以所属国家开头，可选上级行政区、类别与状态。 */
+    ReferenceSubdivision toSubdivision(CountrySubdivisionResponseBody item) {
+        ReferenceDataKind kind = ReferenceDataKind.SUBDIVISION;
+        String code = requireCode(kind, item.getSubdivisionCode(), SUBDIVISION_CODE);
+        String countryCode = requireField(kind, code, item.getCountryCode(), COUNTRY_CODE);
+        if (!code.startsWith(countryCode + "-")) {
+            throw invalid(kind, code + " 与所属国家 " + countryCode + " 不一致");
+        }
+        return new ReferenceSubdivision(code, countryCode,
+            optionalField(kind, code, item.getParentSubdivisionCode(), SUBDIVISION_CODE),
+            requireField(kind, code, item.getCategory(), OPEN_CODE), status(kind, code, item.getStatus()));
+    }
+
+    /** 行业：层级 1 / 2，细类必须有上级大类，可选建议 MCC 与状态。 */
+    ReferenceIndustry toIndustry(IndustryResponseBody item) {
+        ReferenceDataKind kind = ReferenceDataKind.INDUSTRY;
+        String code = requireCode(kind, item.getIndustryCode(), INDUSTRY_CODE);
+        Integer level = item.getLevel();
+        String parentCode = optionalField(kind, code, item.getParentIndustryCode(), INDUSTRY_CODE);
+        if (level == null || (level != 1 && level != 2) || (level == 2) != (parentCode != null)) {
+            throw invalid(kind, code + " 层级 " + level + " 与上级 " + parentCode + " 不一致");
+        }
+        return new ReferenceIndustry(code, parentCode, level,
+            optionalField(kind, code, item.getDefaultMccCode(), MCC_CODE), status(kind, code, item.getStatus()));
+    }
+
+    /** MCC：四位数字、高风险标记必填与状态。 */
+    ReferenceMcc toMcc(MccResponseBody item) {
+        ReferenceDataKind kind = ReferenceDataKind.MCC;
+        String code = requireCode(kind, item.getMccCode(), MCC_CODE);
+        if (item.getNetworkHighRisk() == null) {
+            throw invalid(kind, code + " 缺少 networkHighRisk");
+        }
+        return new ReferenceMcc(code, item.getNetworkHighRisk(), status(kind, code, item.getStatus()));
+    }
+
+    /** 编码必填且符合格式。 */
+    private static String requireCode(ReferenceDataKind kind, String code, Pattern format) {
+        if (code == null || !format.matcher(code).matches()) {
+            throw invalid(kind, "编码非法 " + code);
+        }
+        return code;
+    }
+
+    /** 必填字段符合格式。 */
+    private static String requireField(ReferenceDataKind kind, String code, String value, Pattern format) {
+        if (value == null || !format.matcher(value).matches()) {
+            throw invalid(kind, code + " 字段格式非法 " + value);
+        }
+        return value;
+    }
+
+    /** 可空字段有值时符合格式。 */
+    private static String optionalField(ReferenceDataKind kind, String code, String value, Pattern format) {
+        return value == null ? null : requireField(kind, code, value, format);
+    }
+
+    /** 解析 DRAFT / ACTIVE / INACTIVE。 */
+    private static ReferenceDataStatus status(ReferenceDataKind kind, String code, String value) {
+        return parse(kind, code, ReferenceDataStatus.class, value);
+    }
+
+    /** 按稳定 Code 解析封闭枚举；未知或缺失使该种类本次失败。 */
+    private static <E extends Enum<E> & CodeEnum> E parse(ReferenceDataKind kind, String code, Class<E> type,
+        String value) {
+        for (E candidate : type.getEnumConstants()) {
+            if (candidate.getCode().equals(value)) {
+                return candidate;
+            }
+        }
+        throw invalid(kind, code + " 的 " + type.getSimpleName() + " 无法识别 " + value);
+    }
+
+    /** 响应不合法：该种类本次失败。 */
+    private static ErrorException invalid(ReferenceDataKind kind, String detail) {
+        return new ErrorException(CommonErrorCode.UPSTREAM_INVALID_RESPONSE,
+            "Platform 参考数据响应无效: " + kind.getCode() + " " + detail);
+    }
+}
