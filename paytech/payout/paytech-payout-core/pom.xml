<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-payout</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paytech-payout-core</artifactId>
    <packaging>jar</packaging>

    <name>PayTech Payout Core</name>
    <description>Payout business implementation: dal, domain, domainservice, processors, notification compensation handler and outbound integrations; no boot class or controller.</description>

    <dependencies>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-payout-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 收款账户原值 Protect / Reveal（PAYOUT_BENEFICIARY_V1 REFERENCE、PAYOUT_BANK_ACCOUNT_KEY_V1 STABLE），事务外调用。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-vault-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 余额解释读取 account 的 Owner 余额列表（BalanceQueryApi positions），事务外调用。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-account-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 状态变化通知提交 Platform 普通通知（NotificationCommandApi，tenantRecipients），补偿任务中调用。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 状态变化通知：与账户状态在同一本地事务登记 BENEFICIARY_NOTIFICATION，提交后调用 Platform 通知。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <!-- 写 Processor 的 AbstractLockProcessor 资源锁（PAYOUT_BENEFICIARY_OWNER）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mybatis-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
