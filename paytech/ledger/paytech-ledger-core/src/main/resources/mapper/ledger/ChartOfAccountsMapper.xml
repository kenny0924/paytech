<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.ledger.core.dal.mapper.ChartOfAccountsMapper">
    <select id="selectByChartCode" resultType="com.paytech.ledger.core.dal.dataobject.ChartOfAccounts">
        SELECT id, chart_code, chart_name, status, create_time, update_time FROM t_chart_of_accounts WHERE chart_code = #{chartCode}
    </select>
</mapper>
