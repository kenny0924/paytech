<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.channel.connector.core.dal.mapper.ChannelCostPlanMapper">
    <!-- 闭合枚举列以内联 CodeEnumTypeHandler 按 javaType 绑定（未知 Code 读取失败），其余列按下划线转驼峰自动映射。 -->
    <resultMap id="row" type="com.paytech.channel.connector.core.dal.dataobject.ChannelCostPlan" autoMapping="true">
        <result column="status" property="status" javaType="com.paytech.channel.connector.core.enums.ChannelCostPlanStatus" typeHandler="com.paytech.foundation.mybatis.typehandler.CodeEnumTypeHandler"/>
    </resultMap>

    <sql id="columns">id, channel_id, plan_code, current_ver_id, status, version, create_time, update_time</sql>

    <insert id="insert">
        INSERT INTO t_channel_cost_plan (<include refid="columns"/>)
        VALUES (#{id}, #{channelId}, #{planCode}, #{currentVerId}, #{status.code}, #{version}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="row">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="row">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE plan_code = #{planCode}
    </select>

    <select id="selectByChannelId" resultMap="row">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE channel_id = #{channelId}
    </select>

    <select id="selectByCodeForUpdate" resultMap="row"
            flushCache="true" useCache="false">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE plan_code = #{planCode} FOR UPDATE
    </select>

    <resultMap id="summary" type="com.paytech.channel.connector.domain.ChannelCostPlanSummaryView" autoMapping="true">
        <result column="status" property="status" javaType="com.paytech.channel.connector.core.enums.ChannelCostPlanStatus" typeHandler="com.paytech.foundation.mybatis.typehandler.CodeEnumTypeHandler"/>
    </resultMap>

    <sql id="summaryFilter">
        <where>
            <if test="channelId != null">AND p.channel_id = #{channelId}</if>
            <if test="status != null">AND p.status = #{status.code}</if>
        </where>
    </sql>

    <!-- 同库组合：Channel 编码与名称、当前版本号与生效时间、待复核版本数；排序稳定，数据库分页。 -->
    <select id="selectSummaries" resultMap="summary">
        SELECT p.id AS plan_id, p.plan_code, p.channel_id, c.channel_code, c.channel_name, p.status,
               v.cost_ver AS current_cost_ver, v.effective_from AS current_effective_from,
               (SELECT COUNT(*) FROM t_channel_cost_plan_ver pv
                 WHERE pv.plan_id = p.id AND pv.status = 'PENDING_APPROVAL') AS pending_approval_count,
               p.update_time
        FROM t_channel_cost_plan p
        LEFT JOIN t_payment_channel c ON c.channel_id = p.channel_id
        LEFT JOIN t_channel_cost_plan_ver v ON v.id = p.current_ver_id
        <include refid="summaryFilter"/>
        ORDER BY p.update_time DESC, p.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countSummaries" resultType="long">
        SELECT COUNT(*) FROM t_channel_cost_plan p <include refid="summaryFilter"/>
    </select>

    <update id="updateCurrentVersion">
        UPDATE t_channel_cost_plan
        SET current_ver_id = #{currentVerId}, status = 'ACTIVE', version = version + 1, update_time = #{now}
        WHERE id = #{plan.id} AND version = #{plan.version}
    </update>
</mapper>
