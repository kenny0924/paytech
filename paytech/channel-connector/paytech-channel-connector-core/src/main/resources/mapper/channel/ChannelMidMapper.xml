<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.channel.connector.core.dal.mapper.ChannelMidMapper">
    <resultMap id="row" type="com.paytech.channel.connector.core.dal.dataobject.ChannelMid">
        <result column="mid_id" property="midId"/>
        <result column="channel_id" property="channelId"/>
        <result column="channel_account_id" property="channelAccountId"/>
        <result column="external_mid_code" property="externalMidCode"/>
        <result column="entity_no" property="entityNo"/>
        <result column="mid_status" property="midStatus" javaType="com.paytech.channel.connector.core.enums.ChannelStatus"
                typeHandler="com.paytech.foundation.mybatis.typehandler.CodeEnumTypeHandler"/>
        <result column="activated_at" property="activatedAt"
                typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="closed_at" property="closedAt"
                typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="create_time" property="createTime"
                typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="update_time" property="updateTime"
                typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
    </resultMap>
    <sql id="columns">mid_id, channel_id, channel_account_id, external_mid_code, entity_no, mid_status, activated_at,
        closed_at, create_time, update_time
    </sql>
    <select id="findByAccountIds" resultMap="row">
        SELECT
        <include refid="columns"/>
        FROM t_channel_mid WHERE channel_account_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY mid_id
    </select>
    <select id="findById" resultMap="row">
        SELECT
        <include refid="columns"/>
        FROM t_channel_mid WHERE mid_id = #{id}
    </select>
    <resultMap id="summary" type="com.paytech.channel.connector.domain.ChannelMidSummaryView" autoMapping="true">
        <result column="mid_status" property="midStatus" javaType="com.paytech.channel.connector.core.enums.ChannelStatus"
                typeHandler="com.paytech.foundation.mybatis.typehandler.CodeEnumTypeHandler"/>
    </resultMap>
    <sql id="summaryFilter">
        <where>
            <if test="criteria.channelId != null">AND m.channel_id = #{criteria.channelId}</if>
            <if test="criteria.channelAccountId != null">AND m.channel_account_id = #{criteria.channelAccountId}</if>
            <if test="criteria.entityNo != null">AND m.entity_no = #{criteria.entityNo}</if>
            <if test="criteria.status != null">AND m.mid_status = #{criteria.status.code}</if>
            <if test="criteria.externalMidCode != null">
                AND m.external_mid_code LIKE CONCAT(#{criteria.externalMidCodePrefix}, '%')
            </if>
        </where>
    </sql>
    <!-- 同库组合：Channel 编码、当前账号名称与能力组计数；排序稳定，数据库分页。 -->
    <select id="selectSummaries" resultMap="summary">
        SELECT m.mid_id, m.channel_id, c.channel_code, m.channel_account_id, a.account_name, m.external_mid_code,
               m.entity_no, m.mid_status,
               (SELECT COUNT(*) FROM t_mid_capability mc WHERE mc.mid_id = m.mid_id) AS capability_group_count,
               (SELECT COUNT(*) FROM t_mid_capability mc
                 WHERE mc.mid_id = m.mid_id AND mc.capability_status = 'ENABLED') AS enabled_capability_group_count,
               m.activated_at, m.update_time
        FROM t_channel_mid m
        LEFT JOIN t_payment_channel c ON c.channel_id = m.channel_id
        LEFT JOIN t_channel_account a ON a.channel_account_id = m.channel_account_id
        <include refid="summaryFilter"/>
        ORDER BY m.update_time DESC, m.mid_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countSummaries" resultType="long">
        SELECT COUNT(*) FROM t_channel_mid m
        <include refid="summaryFilter"/>
    </select>

    <!-- CC-B 追加：MID 管理写入 -->
    <insert id="insert">
        INSERT INTO t_channel_mid (<include refid="columns"/>)
        VALUES (#{midId}, #{channelId}, #{channelAccountId}, #{externalMidCode}, #{entityNo}, #{midStatus.code},
        #{activatedAt}, #{closedAt}, #{createTime}, #{updateTime})
    </insert>
    <update id="updateAccount">
        UPDATE t_channel_mid SET channel_account_id = #{toAccountId}, update_time = #{now}
        WHERE mid_id = #{midId} AND channel_account_id = #{fromAccountId} AND mid_status &lt;&gt; 'CLOSED'
    </update>
    <update id="updateStatus">
        UPDATE t_channel_mid SET mid_status = #{toStatus.code}, activated_at = #{activatedAt}, closed_at = #{closedAt},
        update_time = #{now}
        WHERE mid_id = #{midId} AND mid_status = #{fromStatus.code}
    </update>
    <select id="countOpenByChannel" resultType="long">
        SELECT COUNT(*) FROM t_channel_mid WHERE channel_id = #{channelId} AND mid_status &lt;&gt; 'CLOSED'
    </select>
    <select id="countOpenByAccount" resultType="long">
        SELECT COUNT(*) FROM t_channel_mid WHERE channel_account_id = #{channelAccountId} AND mid_status &lt;&gt; 'CLOSED'
    </select>
</mapper>
