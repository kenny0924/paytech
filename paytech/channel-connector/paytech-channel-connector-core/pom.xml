<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-channel-connector</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-channel-connector-core</artifactId>
    <packaging>jar</packaging>
    <name>PayTech Channel Connector Core</name>
    <description>Channel / account / MID repositories, capability resolution, candidate query, frozen-target checks,
        in-process standard API execution with result mapping, and channel cost plan Maker-Checker / resolution / activation.</description>
    <dependencies>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-channel-connector-api</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-common-core</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-mybatis-support</artifactId></dependency>
        <!-- 渠道成本方案写入口的 AbstractLockProcessor 资源锁、Snowflake 主键与 RFC 8785 内容摘要（需求 billing-计费事实模型重构与渠道成本迁出）。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-redis-starter</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-snowflake-id</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-json-canonicalization</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis</artifactId></dependency>
        <dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <!-- 执行配置读取经 Vault 还原冻结账号（无生产调用方，保留 Processor 与测试）。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-vault-client</artifactId></dependency>
        <!-- 渠道协议能力（2026-10-20 统一对外出口第一段）：进程内执行标准 API、接入方存在性查询与变更记录服务；core → protocol 单向。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-channel-connector-protocol</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><annotationProcessorPaths><path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></path></annotationProcessorPaths></configuration>
            </plugin>
        </plugins>
    </build>
</project>
