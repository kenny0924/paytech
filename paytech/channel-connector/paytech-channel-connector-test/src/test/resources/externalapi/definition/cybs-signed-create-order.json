{
  "params": [
    {"name": "secretKey", "dataType": "PROTECTED_HANDLE", "required": true},
    {"name": "keyId", "dataType": "STRING", "required": true},
    {"name": "merchantId", "dataType": "STRING", "required": true},
    {"name": "host", "dataType": "STRING", "required": true}
  ],
  "fixedValues": {
    "BODY:version": {"kind": "EXPRESSION", "expression": "'1.5'"}
  },
  "transport": {
    "protocol": "HTTP",
    "method": "POST",
    "endpointCode": "DEMO_GATEWAY",
    "pathTemplate": "/orderAndPay",
    "connectTimeoutMs": 2000,
    "responseTimeoutMs": 10000
  },
  "requestEncoding": "JSON",
  "responseDecoding": "JSON",
  "decimalEncoding": "NUMBER",
  "scripts": [
    {"id": "sign", "scriptCode": "CYBS_SIGN", "stage": "REQUEST",
     "params": {"secretKey": {"kind": "PATH", "path": "params.secretKey"},
                "keyId": {"kind": "PATH", "path": "params.keyId"},
                "merchantId": {"kind": "PATH", "path": "params.merchantId"},
                "host": {"kind": "PATH", "path": "params.host"},
                "requestTarget": {"kind": "EXPRESSION", "expression": "'post /pts/v2/payments'"}}}
  ],
  "statusRules": [
    {"condition": "http.responseStatus == 200 && http.responseBody.code == 'APPLY_SUCCESS'", "executeStatus": "SUCCESS"},
    {"condition": "http.responseStatus == 200 && http.responseBody.code == 'PARAMS_INVALID'", "executeStatus": "FAIL"}
  ],
  "outputs": {
    "SUCCESS": [
      {"name": "transactionRef", "dataType": "STRING", "required": true,
       "value": {"kind": "PATH", "path": "http.responseBody.data.tradeToken"}},
      {"name": "amount", "dataType": "DECIMAL", "required": true,
       "value": {"kind": "PATH", "path": "http.responseBody.data.totalAmount"}}
    ],
    "FAIL": [
      {"name": "errorCode", "dataType": "STRING", "required": true,
       "value": {"kind": "PATH", "path": "http.responseBody.code"}}
    ]
  }
}
