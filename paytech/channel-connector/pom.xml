<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-channel-connector</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Channel Connector</name>
    <description>Channel connector service aggregator: payment channel / account / MID configuration, candidate query and
        channel operation execution through the Platform standard API (D06).</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-channel-connector-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-channel-connector-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-channel-connector-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Reactor 内的 Vault Java Client 与 Platform 合同（02a / 02d 新坐标）。 -->
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-vault-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- 原 payment-orchestration-service 的禁令（09 §1.4），并禁止依赖其他服务的 core / app（D09）。 -->
                        <id>enforce-channel-connector-dependency-boundaries</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>io.github.openfeign:*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-channel-connector-core</include>
                                        <include>com.paytech:paytech-channel-connector-app</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-coverage</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>paytech-channel-connector-api</module>
        <module>paytech-channel-connector-core</module>
        <module>paytech-channel-connector-app</module>
        <module>paytech-channel-connector-test</module>
    </modules>
</project>
