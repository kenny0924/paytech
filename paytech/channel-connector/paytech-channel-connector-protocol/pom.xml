<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-channel-connector</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-channel-connector-protocol</artifactId>
    <packaging>jar</packaging>
    <name>PayTech Channel Connector Protocol</name>
    <description>Channel protocol capability migrated from Platform (2026-10-20 unified outbound, phase 1): standard APIs,
        integrations, atomic APIs, scripts, flows, execution engine, sandbox verification and the channel config change log.</description>
    <dependencies>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-channel-connector-api</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-common-core</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-http-problem</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-mybatis-support</artifactId></dependency>
        <!-- 外部 API 配置写入口的 external-api-config 资源锁与 Snowflake 主键。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-redis-starter</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-snowflake-id</artifactId></dependency>
        <!-- 执行引擎的 CHANNEL_ACCOUNT_CONFIG 初始化函数以 channel-connector-service 身份 Reveal 渠道账号配置。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-vault-client</artifactId></dependency>
        <!-- 沙箱验证运行以本地补偿任务 INTEGRATION_VERIFY_RUN 异步执行。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-compensation-event</artifactId></dependency>
        <!-- 卡直付执行时凭一次性读卡票据向 card-service 读取卡数据（PAYMENT_CARD 初始化函数）。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-card-api</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis</artifactId></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>com.googlecode.aviator</groupId><artifactId>aviator</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><annotationProcessorPaths><path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></path></annotationProcessorPaths></configuration>
            </plugin>
        </plugins>
    </build>
</project>
