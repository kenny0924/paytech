<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-acquiring</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Acquiring</name>
    <description>Acquiring service aggregator (from commerce-service): orders, hosted checkout, refunds and cancellation; transaction / checkout / command packages share one core and mor_acquiring.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-acquiring-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-acquiring-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-acquiring-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 服务间合同：Reactor 内的 payment / platform-support / counterparty api；Risk 统一评估合同为 paytech-risk-decision-api（第 06 步）。
                 commercial-api：Checkout 商业上下文真实解析（2026-10-24 商业关系快照与真实解析接入），由 acquiring.commercial.resolution-mode=REAL 启用。 -->
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-card-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-counterparty-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-risk-decision-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commercial-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- 原 commerce-service 禁令（09 §1.4），并禁止依赖其他服务的 core / app（D09）。 -->
                        <id>enforce-acquiring-foundation-scope</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-jdbc</exclude>
                                        <exclude>com.h2database:*</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                        <exclude>com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis*</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>io.lettuce:*</exclude>
                                        <exclude>redis.clients:*</exclude>
                                        <exclude>org.redisson:*</exclude>
                                        <exclude>com.github.ben-manes.caffeine:*</exclude>
                                        <exclude>com.paytech:paytech-caffeine-starter</exclude>
                                        <exclude>com.paytech:paytech-redis-starter</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-amqp</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>com.rabbitmq:*</exclude>
                                        <exclude>com.paytech:paytech-vault-client</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-security</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.mockito:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-acquiring-core</include>
                                        <include>com.paytech:paytech-acquiring-app</include>
                                        <!-- Order coordination uses only the shared Redis Starter and its clients. -->
                                        <include>com.paytech:paytech-redis-starter</include>
                                        <include>org.redisson:redisson</include>
                                        <include>org.springframework.boot:spring-boot-starter-data-redis</include>
                                        <include>org.springframework.data:spring-data-redis</include>
                                        <include>io.lettuce:lettuce-core</include>
                                        <!-- Spring Cloud Commons uses crypto utilities, not a Security filter chain. -->
                                        <include>org.springframework.security:spring-security-crypto</include>
                                        <!-- 2026-10-15 用户批准 Commerce 消费 Payment 支付结果：仅允许 Starter 及其 RabbitMQ 客户端，其他 AMQP/MQ 直连依赖仍禁止。 -->
                                        <include>org.springframework.boot:spring-boot-starter-amqp</include>
                                        <include>org.springframework.amqp:spring-amqp</include>
                                        <include>org.springframework.amqp:spring-rabbit</include>
                                        <include>com.rabbitmq:amqp-client</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>paytech-acquiring-api</module>
        <module>paytech-acquiring-core</module>
        <module>paytech-acquiring-app</module>
        <module>paytech-acquiring-test</module>
    </modules>
</project>
