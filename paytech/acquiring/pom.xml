<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>paytech-commerce-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Commerce Service</name>
    <description>Commerce service reactor.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-api</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>risk-api</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>platform-support-api</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency><groupId>com.paytech</groupId><artifactId>paytech-commerce-customer-api</artifactId><version>${project.version}</version></dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>client-contract-api</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commerce-client-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commerce-web</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-commerce-foundation-scope</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-jdbc</exclude>
                                        <exclude>com.h2database:*</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                        <exclude>com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis*</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>io.lettuce:*</exclude>
                                        <exclude>redis.clients:*</exclude>
                                        <exclude>org.redisson:*</exclude>
                                        <exclude>com.github.ben-manes.caffeine:*</exclude>
                                        <exclude>com.paytech:paytech-caffeine-starter</exclude>
                                        <exclude>com.paytech:paytech-redis-starter</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-amqp</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>com.rabbitmq:*</exclude>
                                        <exclude>com.paytech:paytech-vault-client</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-security</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.mockito:*</exclude>
                                    </excludes>
                                    <includes>
                                        <!-- Order coordination uses only the shared Redis Starter and its clients. -->
                                        <include>com.paytech:paytech-redis-starter</include>
                                        <include>org.redisson:redisson</include>
                                        <include>org.springframework.boot:spring-boot-starter-data-redis</include>
                                        <include>org.springframework.data:spring-data-redis</include>
                                        <include>io.lettuce:lettuce-core</include>
                                        <!-- Spring Cloud Commons uses crypto utilities, not a Security filter chain. -->
                                        <include>org.springframework.security:spring-security-crypto</include>
                                        <!-- 2026-10-15 用户批准 Commerce 消费 Payment 支付结果：仅允许 Starter 及其 RabbitMQ 客户端，其他 AMQP/MQ 直连依赖仍禁止。 -->
                                        <include>org.springframework.boot:spring-boot-starter-amqp</include>
                                        <include>org.springframework.amqp:spring-amqp</include>
                                        <include>org.springframework.amqp:spring-rabbit</include>
                                        <include>com.rabbitmq:amqp-client</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>paytech-commerce-customer-api</module>
        <module>paytech-commerce-client-api</module>
        <module>paytech-commerce-web</module>
        <module>paytech-commerce-test</module>
    </modules>
</project>
