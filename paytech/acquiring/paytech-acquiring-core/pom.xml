<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-acquiring</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paytech-acquiring-core</artifactId>
    <name>PayTech Acquiring Core</name>
    <description>Acquiring business implementation (transaction / checkout / command packages on mor_acquiring): processors, domain
        services, repositories and mappers, outbound ports, the Payment result MQ handler and compensation handlers. No Spring
        Boot entry and no controllers.</description>

    <dependencies>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-acquiring-api</artifactId>
        </dependency>
        <!-- 服务间合同：consumer（Customer 建或取、存卡资格）、payment（Intent / 卡工具 / 已存卡列表）、risk、platform（Webhook）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-consumer-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-payment-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-card-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-risk-decision-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <!-- 支付提交按 order:{id} TRY_LOCK（AbstractLockProcessor）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mybatis-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <!-- Client Webhook 冻结载荷的 RFC 8785 摘要。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-json-canonicalization</artifactId>
        </dependency>
        <!-- 出站请求校验失败类型（HttpRequestValidationException）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-http-client-support</artifactId>
        </dependency>
        <!-- 领域异常实现 RetryAfterProvider，供 Web 层写出 Retry-After。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mvc-web-starter</artifactId>
        </dependency>
        <!-- Payment 支付结果消费者（@RabbitListener 在 core，队列声明在 app）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
