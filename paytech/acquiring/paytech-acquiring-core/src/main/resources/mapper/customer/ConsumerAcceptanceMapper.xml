<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commerce.core.dal.mapper.customer.ConsumerAcceptanceMapper">
    <resultMap id="ConsumerAcceptance" type="com.paytech.commerce.core.dal.dataobject.customer.ConsumerAcceptance">
        <id column="consumer_acceptance_id" property="consumerAcceptanceId" javaType="_long"/>
        <result column="consumer_contract_id" property="consumerContractId" javaType="_long"/>
        <result column="network_evidence_id" property="networkEvidenceId" javaType="_long"/>
        <result column="acceptance_type" property="acceptanceType" javaType="com.paytech.commerce.domain.enums.ConsumerAcceptanceType"/>
        <result column="accepted_at" property="acceptedAt" javaType="java.time.Instant"/>
        <result column="create_time" property="createTime" javaType="java.time.Instant"/>
    </resultMap>
    <select id="findByContractId" resultMap="ConsumerAcceptance" useCache="false" flushCache="true">
        SELECT consumer_acceptance_id,consumer_contract_id,network_evidence_id,acceptance_type,
            accepted_at,create_time
        FROM t_consumer_acceptance WHERE consumer_contract_id=#{contractId} ORDER BY acceptance_type
    </select>
    <insert id="insert">
        INSERT INTO t_consumer_acceptance (consumer_acceptance_id,consumer_contract_id,network_evidence_id,
            acceptance_type,accepted_at,create_time)
        VALUES (#{consumerAcceptanceId},#{consumerContractId},#{networkEvidenceId},
            #{acceptanceType},#{acceptedAt},#{createTime})
    </insert>
    <select id="existsByOrderId" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM t_consumer_acceptance a
        JOIN t_consumer_contract c ON c.consumer_contract_id=a.consumer_contract_id WHERE c.order_id=#{orderId})
    </select>
</mapper>
