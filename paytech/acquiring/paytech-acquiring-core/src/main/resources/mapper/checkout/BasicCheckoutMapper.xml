<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commerce.core.dal.mapper.checkout.BasicCheckoutMapper">
    <resultMap id="Basic" type="com.paytech.commerce.core.dal.dataobject.checkout.CheckoutCreationView">
        <constructor>
            <arg column="order_id" javaType="_long"/>
            <arg column="order_no" javaType="java.lang.String"/>
            <arg column="client_id" javaType="_long"/>
            <arg column="client_order_id" javaType="java.lang.String"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="merchandise_amount" javaType="java.math.BigDecimal"/>
            <arg column="discount_amount" javaType="java.math.BigDecimal"/>
            <arg column="net_amount" javaType="java.math.BigDecimal"/>
            <arg column="tax_amount" javaType="java.math.BigDecimal"/>
            <arg column="rounding_amount" javaType="java.math.BigDecimal"/>
            <arg column="total_amount" javaType="java.math.BigDecimal"/>
            <arg column="currency" javaType="java.lang.String"/>
            <arg column="expires_at" javaType="java.time.Instant"/>
            <arg column="order_status" javaType="com.paytech.commerce.domain.enums.OrderStatus"/>
            <arg column="order_version" javaType="_long"/>
            <arg column="checkout_session_id" javaType="_long"/>
            <arg column="public_token" javaType="java.lang.String"/>
            <arg column="public_origin" javaType="java.lang.String"/>
            <arg column="session_status" javaType="com.paytech.commerce.domain.enums.CheckoutSessionStatus"/>
            <arg column="session_version" javaType="_long"/>
            <arg column="preparation_command_id" javaType="java.lang.Long"/>
            <arg column="termination_requested_at" javaType="java.time.Instant"/>
            <arg column="context_present" javaType="_boolean"/>
            <arg column="payment_present" javaType="_boolean"/>
        </constructor>
    </resultMap>
    <resultMap id="Item" type="com.paytech.commerce.core.dal.dataobject.order.OrderItem">
        <constructor>
            <arg column="order_item_id" javaType="_long"/>
            <arg column="order_id" javaType="_long"/>
            <arg column="client_item_id" javaType="java.lang.String"/>
            <arg column="item_name" javaType="java.lang.String"/>
            <arg column="item_description" javaType="java.lang.String"/>
            <arg column="product_type_code" javaType="java.lang.String"/>
            <arg column="tax_category_code" javaType="java.lang.String"/>
            <arg column="quantity" javaType="java.math.BigDecimal"/>
            <arg column="unit_amount" javaType="java.math.BigDecimal"/>
            <arg column="line_gross_amount" javaType="java.math.BigDecimal"/>
            <arg column="line_discount_amount" javaType="java.math.BigDecimal"/>
            <arg column="line_net_amount" javaType="java.math.BigDecimal"/>
            <arg column="line_tax_amount" javaType="java.math.BigDecimal"/>
            <arg column="line_total_amount" javaType="java.math.BigDecimal"/>
            <arg column="currency" javaType="java.lang.String"/>
            <arg column="sort_no" javaType="_int"/>
            <arg column="create_time" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>
    <select id="select" resultMap="Basic" flushCache="true" useCache="false">
        SELECT o.order_id,o.order_no,o.client_id,o.client_order_id,o.entity_no,
            o.merchandise_amount,o.discount_amount,o.net_amount,o.tax_amount,o.rounding_amount,o.total_amount,
            o.currency,o.expires_at,o.order_status,o.version AS order_version,s.checkout_session_id,
            s.public_token,s.public_origin,s.session_status,s.version AS session_version,
            o.preparation_command_id,o.termination_requested_at,
            EXISTS(SELECT 1 FROM t_order_context c WHERE c.order_id=o.order_id) AS context_present,
            EXISTS(SELECT 1 FROM t_order_payment_projection p WHERE p.order_id=o.order_id) AS payment_present
        FROM t_commerce_order o INNER JOIN t_checkout_session s ON s.order_id=o.order_id
        WHERE o.client_id=#{clientId} AND o.order_id=#{orderId} AND o.order_no=#{orderNo}
        <if test="lock">FOR UPDATE</if>
    </select>
    <select id="selectItems" resultMap="Item">
        SELECT i.order_item_id,i.order_id,i.client_item_id,i.item_name,i.item_description,i.product_type_code,
            i.tax_category_code,i.quantity,i.unit_amount,i.line_gross_amount,i.line_discount_amount,i.line_net_amount,
            NULL AS line_tax_amount,NULL AS line_total_amount,i.currency,i.sort_no,i.create_time
        FROM t_order_item i INNER JOIN t_commerce_order o ON o.order_id=i.order_id
        WHERE o.client_id=#{clientId} AND o.order_id=#{orderId} ORDER BY i.sort_no
    </select>
</mapper>
