<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.master.core.dal.mapper.ClientDocumentMapper">
 <sql id="scope">FROM t_application_document WHERE client_application_id=#{applicationId} AND partner_application_id IS NULL AND operating_entity_application_id IS NULL</sql>
 <sql id="columns">document_id,subject_party_id,requirement_code,document_type,file_address,content_hash</sql>
 <select id="documents" resultType="com.paytech.client.master.core.dal.dataobject.ClientApplicationDocument">
 SELECT <include refid="columns"/> <include refid="scope"/> ORDER BY document_id
 </select>
 <select id="document" resultType="com.paytech.client.master.core.dal.dataobject.ClientApplicationDocument">
 SELECT <include refid="columns"/> <include refid="scope"/> AND document_id=#{id}
 </select>
 <insert id="insert">
 INSERT INTO t_application_document(document_id,client_application_id,subject_party_id,requirement_code,document_type,file_address,content_hash,create_time,update_time)
 VALUES(#{document.documentId},#{applicationId},#{document.subjectPartyId},#{document.requirementCode},#{document.documentType},#{document.fileAddress},#{document.contentHash},#{now},#{now})
 </insert>
 <delete id="remove">DELETE <include refid="scope"/> AND document_id=#{id}</delete>
</mapper>
