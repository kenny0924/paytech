<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.master.core.dal.mapper.ClientStoredCardSettingMapper">
    <select id="findEnabled" resultType="java.lang.Boolean">
        SELECT stored_card_enabled=1 FROM t_client_stored_card_setting WHERE client_id=#{clientId}
    </select>
</mapper>
