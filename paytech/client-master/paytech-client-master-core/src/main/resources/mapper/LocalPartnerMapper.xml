<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.master.core.dal.mapper.LocalPartnerMapper">
    <resultMap id="LocalPartner" type="com.paytech.client.master.core.dal.dataobject.CheckoutRecords$LocalPartner">
        <constructor>
            <arg column="local_partner_id" javaType="java.lang.Long"/>
            <arg column="party_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.paytech.client.master.domain.enums.LocalPartnerStatus"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="LocalPartner">
        SELECT local_partner_id, party_id, status
        FROM t_local_partner
        WHERE local_partner_id IN (SELECT source_partner_id FROM t_entity_source_relation WHERE entity_no IN (SELECT entity_no FROM t_client_entity_affiliation WHERE client_id = #{clientId}) AND source_type='PARTNER')
        ORDER BY local_partner_id
    </select>
</mapper>
