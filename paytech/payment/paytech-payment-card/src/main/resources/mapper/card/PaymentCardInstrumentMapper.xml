<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.payment.card.core.dal.mapper.PaymentCardInstrumentMapper">
    <resultMap id="row" type="com.paytech.payment.card.core.dal.dataobject.PaymentCardInstrument">
        <id column="payment_card_instrument_id" property="paymentCardInstrumentId"/>
        <result column="payment_card_credential_id" property="paymentCardCredentialId"/>
        <result column="client_id" property="clientId"/>
        <result column="customer_id" property="customerId"/>
        <result column="save_requested" property="saveRequested"/>
        <result column="payment_stored_card_id" property="paymentStoredCardId"/>
        <result column="create_time" property="createTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="update_time" property="updateTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
    </resultMap>

    <sql id="PaymentCardInstrumentColumns">
        payment_card_instrument_id, payment_card_credential_id, client_id, customer_id, save_requested,
        payment_stored_card_id, create_time, update_time
    </sql>

    <insert id="insertInstrument">
        INSERT INTO t_payment_card_instrument (<include refid="PaymentCardInstrumentColumns"/>)
        VALUES (#{paymentCardInstrumentId}, #{paymentCardCredentialId}, #{clientId}, #{customerId}, #{saveRequested},
            #{paymentStoredCardId},
            #{createTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP},
            #{updateTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP})
    </insert>

    <select id="findInstrument" resultMap="row">
        SELECT <include refid="PaymentCardInstrumentColumns"/>
        FROM t_payment_card_instrument
        WHERE payment_card_instrument_id = #{paymentCardInstrumentId}
    </select>
</mapper>
