<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.payment.card.core.dal.mapper.PaymentCardMapper">
    <resultMap id="row" type="com.paytech.payment.card.core.dal.dataobject.PaymentCard">
        <id column="payment_card_id" property="paymentCardId"/>
        <result column="card_fingerprint" property="cardFingerprint"/>
        <result column="card_bin" property="cardBin"/>
        <result column="pan_last4" property="panLast4"/>
        <result column="encrypted_pan" property="encryptedPan" jdbcType="VARBINARY"/>
        <result column="dek_vault_token" property="dekVaultToken"/>
        <result column="create_time" property="createTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="update_time" property="updateTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
    </resultMap>

    <sql id="PaymentCardColumns">
        payment_card_id, card_fingerprint, card_bin, pan_last4, encrypted_pan, dek_vault_token, create_time, update_time
    </sql>

    <insert id="insertCard">
        INSERT INTO t_payment_card (<include refid="PaymentCardColumns"/>)
        VALUES (#{paymentCardId}, #{cardFingerprint}, #{cardBin}, #{panLast4}, #{encryptedPan,jdbcType=VARBINARY},
            #{dekVaultToken},
            #{createTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP},
            #{updateTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP})
    </insert>

    <select id="findCard" resultMap="row">
        SELECT <include refid="PaymentCardColumns"/>
        FROM t_payment_card
        WHERE payment_card_id = #{paymentCardId}
    </select>

    <select id="findCardByFingerprint" resultMap="row">
        SELECT <include refid="PaymentCardColumns"/>
        FROM t_payment_card
        WHERE card_fingerprint = #{cardFingerprint}
    </select>
</mapper>
