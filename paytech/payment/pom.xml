<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>
    <artifactId>paytech-payment</artifactId>
    <packaging>pom</packaging>
    <name>PayTech Payment</name>
    <description>Payment service aggregator: intent / attempt / action execution, routing, card domain (until step 12) and
        PaymentSucceeded publication.</description>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-card</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 服务间合同：channel-connector（本步拆出）、Reactor 内的 Vault Java Client；Risk 统一评估合同为 paytech-risk-decision-api（第 06 步）。 -->
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-channel-connector-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-vault-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-risk-decision-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- 原 payment-orchestration-service 的禁令（09 §1.4），并禁止依赖其他服务的 core / app（D09）。 -->
                        <id>enforce-payment-dependency-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>io.github.openfeign:*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-payment-core</include>
                                        <include>com.paytech:paytech-payment-app</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!--
                          R11 过渡（第 12 步前卡域仍在 payment 进程与库内）：只有 paytech-payment-core 与 paytech-payment-app 可以直接依赖
                          paytech-payment-card；这两个模块以 skip 关闭本执行。只检查直接依赖：test 经 app 传递获得卡域类不在禁止之列。
                        -->
                        <id>enforce-payment-card-consumers</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.paytech:paytech-payment-card</exclude>
                                    </excludes>
                                    <message>Only paytech-payment-core and paytech-payment-app may depend on paytech-payment-card (R11 transition until step 12).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-coverage</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <modules>
        <module>paytech-payment-api</module>
        <module>paytech-payment-card</module>
        <module>paytech-payment-core</module>
        <module>paytech-payment-app</module>
        <module>paytech-payment-test</module>
    </modules>
</project>
