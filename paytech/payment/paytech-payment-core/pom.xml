<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-payment-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-payment-execution</artifactId>
    <packaging>jar</packaging>
    <name>Payment Execution</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-payment-card</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-payment-routing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mybatis-support</artifactId>
        </dependency>
        <!-- 支付成功事务内登记 PaymentSucceeded 发布任务，提交后由 Handler 发布（requirements/20261015/payment-支付结果查询与回传）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-payment-execution-isolation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.paytech:paytech-payment-*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.paytech:paytech-payment-routing</include>
                                        <include>com.paytech:paytech-payment-card</include>
                                    </includes>
                                    <message>Payment Execution may depend only on the published Routing and Card capabilities;
                                        Payment API, Web, Test and Channel remain forbidden.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
