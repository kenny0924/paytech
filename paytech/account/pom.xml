<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-account</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Account</name>
    <description>Account service aggregator: subledger Owner accounts, postings and entries in mor_account built from BillingFactRecorded, AccountPosted publication to ledger, bucket movements, maturity and queries (2026-10-19).</description>

    <modules>
        <module>paytech-account-api</module>
        <module>paytech-account-core</module>
        <module>paytech-account-app</module>
        <module>paytech-account-test</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>account-bootstrap-scope</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- No other service's core/app; cross-service calls go through *-api only (D09). -->
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                        <!-- Finance bans copied from 09 §1.4. Step 11b reopens AMQP, RabbitMQ, compensation-event and XXL-Job
                                             for account: it consumes BillingFactRecorded, publishes AccountPosted through paytech-messaging and
                                             runs the balance maturity job as an XXL-Job Handler (technique 2.1). -->
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>com.alibaba.cloud:*</exclude>
                                        <exclude>com.alibaba.nacos:*</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                    </excludes>
                                    <includes>
                                        <!-- Foundation, not a service core. -->
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-account-api</include>
                                        <include>com.paytech:paytech-account-core</include>
                                        <include>com.paytech:paytech-account-app</include>
                                        <include>com.paytech:paytech-account-test</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
