<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- t_owner_account：Owner 账户与实时余额，只读写 mor_account。 -->
<mapper namespace="com.paytech.account.core.dal.mapper.OwnerAccountMapper">
    <sql id="columns">id, account_no, entity_type, entity_id, currency, account_code, owner_type, owner_id, balance_bucket, normal_side, debit_total, credit_total, net_balance, balance_version, account_status, create_time, update_time</sql>

    <sql id="entityWhere">entity_type = #{entityType} AND entity_id = #{entityId} AND currency = #{currency}</sql>

    <sql id="pageWhere">
        <include refid="entityWhere"/>
        <if test="ownerType != null">AND owner_type = #{ownerType}</if>
        <if test="ownerId != null">AND owner_id = #{ownerId}</if>
        <if test="accountCode != null">AND account_code = #{accountCode}</if>
        <if test="bucket != null">AND balance_bucket = #{bucket}</if>
        <if test="accountNo != null">AND account_no = #{accountNo}</if>
    </sql>

    <insert id="insert">
        INSERT INTO t_owner_account (<include refid="columns"/>)
        VALUES (#{id}, #{accountNo}, #{entityType}, #{entityId}, #{currency}, #{accountCode}, #{ownerType}, #{ownerId}, #{balanceBucket}, #{normalSide}, #{debitTotal}, #{creditTotal}, #{netBalance}, #{balanceVersion}, #{accountStatus}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectByIdentity" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount">
        SELECT <include refid="columns"/> FROM t_owner_account
        WHERE <include refid="entityWhere"/> AND account_code = #{accountCode} AND owner_type = #{ownerType}
          AND owner_id = #{ownerId} AND balance_bucket = #{bucket}
    </select>

    <select id="selectById" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount">
        SELECT <include refid="columns"/> FROM t_owner_account WHERE id = #{id}
    </select>

    <select id="selectByIds" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount">
        SELECT <include refid="columns"/> FROM t_owner_account WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id
    </select>

    <select id="selectByIdsForUpdate" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount" flushCache="true" useCache="false">
        SELECT <include refid="columns"/> FROM t_owner_account WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id FOR UPDATE
    </select>

    <select id="selectByEntityForUpdate" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount" flushCache="true" useCache="false">
        SELECT <include refid="columns"/> FROM t_owner_account WHERE <include refid="entityWhere"/>
        ORDER BY id FOR UPDATE
    </select>

    <select id="selectByOwner" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount">
        SELECT <include refid="columns"/> FROM t_owner_account
        WHERE <include refid="entityWhere"/> AND owner_type = #{ownerType} AND owner_id = #{ownerId}
        ORDER BY id
    </select>

    <select id="selectPage" resultType="com.paytech.account.core.dal.dataobject.OwnerAccount">
        SELECT <include refid="columns"/> FROM t_owner_account WHERE <include refid="pageWhere"/>
        ORDER BY account_code, owner_type, owner_id, balance_bucket, id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM t_owner_account WHERE <include refid="pageWhere"/>
    </select>

    <update id="applyChange">
        UPDATE t_owner_account
        SET debit_total = #{debitTotal}, credit_total = #{creditTotal}, net_balance = #{netBalance},
            balance_version = balance_version + 1, update_time = #{now}
        WHERE id = #{account.id} AND balance_version = #{account.balanceVersion}
    </update>
</mapper>
