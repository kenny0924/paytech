<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-card</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-card-core</artifactId>
    <packaging>jar</packaging>
    <name>PayTech Card Core</name>
    <description>Card domain (design/05): card / credential / instrument / stored card tables of mor_card, card encryption,
        Vault-held DEKs, Redis one-time CVV, one-time material tickets and the PaymentSucceeded handler; only card-app may
        depend on it (R11).</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!-- 本服务合同中的稳定代码（读卡票据用途）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-card-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mybatis-support</artifactId>
        </dependency>
        <!-- PaymentSucceeded 消费 Handler 的 @DomainEventHandler 与 DomainEventConsumer（design/08 §1）；消费实现只在 app。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-messaging-api</artifactId>
        </dependency>
        <!-- 每张卡的数据加密密钥由 Vault 托管（agent-docs/decisions/2026-10-15-vault-payment-card-dek.md）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-vault-client</artifactId>
        </dependency>
        <!-- BIN 库导入任务（CARD_BIN_LIBRARY_IMPORT）：版本创建同事务登记，Handler 在 core（R12）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <!-- BIN 库导入读取 Platform 内部文件接口（技术方案 §3.5.3），出站适配在 integration。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-api</artifactId>
        </dependency>
        <!-- BIN 库导入由发卡国推导区域：读进程内国家参考数据快照（2026-10-27 参考数据客户端组件）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-reference-data-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 卡加密与配置的纯 Java 测试（CardCipherTest、PaymentCardPropertiesTest）留在 core：R11 只豁免 card-core / card-app。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
