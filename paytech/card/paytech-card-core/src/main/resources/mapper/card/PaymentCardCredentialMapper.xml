<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.card.core.dal.mapper.PaymentCardCredentialMapper">
    <resultMap id="row" type="com.paytech.card.core.dal.dataobject.PaymentCardCredential">
        <id column="payment_card_credential_id" property="paymentCardCredentialId"/>
        <result column="payment_card_id" property="paymentCardId"/>
        <result column="credential_digest" property="credentialDigest"/>
        <result column="encrypted_details" property="encryptedDetails" jdbcType="VARBINARY"/>
        <result column="expiry_month" property="expiryMonth"/>
        <result column="expiry_year" property="expiryYear"/>
        <result column="verified_time" property="verifiedTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="create_time" property="createTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        <result column="update_time" property="updateTime" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
    </resultMap>

    <sql id="PaymentCardCredentialColumns">
        payment_card_credential_id, payment_card_id, credential_digest, encrypted_details, expiry_month, expiry_year,
        verified_time, create_time, update_time
    </sql>

    <insert id="insertCredential">
        INSERT INTO t_payment_card_credential (<include refid="PaymentCardCredentialColumns"/>)
        VALUES (#{paymentCardCredentialId}, #{paymentCardId}, #{credentialDigest},
            #{encryptedDetails,jdbcType=VARBINARY}, #{expiryMonth}, #{expiryYear},
            #{verifiedTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP},
            #{createTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP},
            #{updateTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP})
    </insert>

    <update id="markVerified">
        UPDATE t_payment_card_credential
        SET verified_time = #{verifiedTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP},
            update_time = #{verifiedTime,typeHandler=com.paytech.foundation.mybatis.typehandler.InstantTypeHandler,jdbcType=TIMESTAMP}
        WHERE payment_card_credential_id = #{paymentCardCredentialId}
          AND verified_time IS NULL
    </update>

    <select id="findCredential" resultMap="row">
        SELECT <include refid="PaymentCardCredentialColumns"/>
        FROM t_payment_card_credential
        WHERE payment_card_credential_id = #{paymentCardCredentialId}
    </select>

    <select id="findCredentialByDigest" resultMap="row">
        SELECT <include refid="PaymentCardCredentialColumns"/>
        FROM t_payment_card_credential
        WHERE payment_card_id = #{paymentCardId}
          AND credential_digest = #{credentialDigest}
    </select>
</mapper>
