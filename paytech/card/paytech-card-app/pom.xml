<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-card</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-card-app</artifactId>
    <name>PayTech Card App</name>
    <description>Deployable card-service: Spring Boot entry, controllers, mor_card DataSource / MyBatis scan, Redis (CVV),
        Vault client (caller card-service), PaymentSucceeded consumption through paytech-messaging, compensation and the
        orphan instrument purge job.</description>
    <dependencies>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-card-core</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-card-api</artifactId></dependency>
        <!-- 内部调用身份（D26）：默认 OFF；入站校验由 MVC Starter 装配，Vault Client 在存在 Token 来源时附加 Token。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-internal-auth</artifactId></dependency>
        <!-- BIN 库导入的 Platform 出站：内部文件接口与国家区域映射复用 Foundation 公共出站边界（2026-10-22）。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-http-client-support</artifactId></dependency>
        <dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-starter-loadbalancer</artifactId></dependency>
        <!-- 注册到 Nacos（Payment、Platform、acquiring、consumer 经服务发现调用）并发现 Vault。 -->
        <dependency><groupId>com.alibaba.cloud</groupId><artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId></dependency>
        <dependency><groupId>com.alibaba.cloud</groupId><artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-mvc-web-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
        <!-- 消费 payment.events 的 PaymentSucceeded（card.payment.p0..p3，design/08）。 -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-amqp</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-messaging</artifactId></dependency>
        <!-- 本库 t_compensation_event 与 XXL-Job 执行器（孤立工具回收任务）。 -->
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-compensation-event</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-redis-starter</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-snowflake-id</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-mybatis-support</artifactId></dependency>
        <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><annotationProcessorPaths><path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></path></annotationProcessorPaths></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-card-core-consumers</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
