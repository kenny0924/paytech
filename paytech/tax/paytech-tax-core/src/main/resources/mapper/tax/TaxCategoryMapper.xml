<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.tax.core.dal.mapper.TaxCategoryMapper">
    <select id="selectByCodes" resultType="com.paytech.tax.core.dal.dataobject.TaxCategory">
        SELECT id, category_code, name, description, status, create_time, update_time FROM t_tax_category
        WHERE category_code IN <foreach collection="codes" item="v" open="(" separator="," close=")">#{v}</foreach> ORDER BY category_code
    </select>
</mapper>
