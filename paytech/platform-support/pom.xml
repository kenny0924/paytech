<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-platform-support</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Platform Support</name>
    <description>Platform Support service aggregator: api / six business core modules / application core / app / test.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-access-control</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-audit-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-file-document</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-data-query</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-platform-support-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Vault Java Client：02d 迁入 Reactor 前从本地仓库解析同版本快照。 -->
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-vault-client</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-platform-foundation-scope</id>
                        <!-- C5：paytech-messaging 需要 spring-amqp，原 AMQP 两条禁令已删除；其余禁令原样保留。 -->
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis-reactive
                                        </exclude>
                                        <exclude>com.xuxueli:*</exclude>
                                        <exclude>com.paytech:paytech-caffeine-starter</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-security</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.xuxueli:xxl-job-core</include>
                                        <include>com.xuxueli:xxl-tool</include>
                                        <include>org.springframework.security:spring-security-crypto</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>paytech-platform-support-api</module>
        <module>paytech-platform-support-access-control</module>
        <module>paytech-platform-support-audit-security</module>
        <module>paytech-platform-support-file-document</module>
        <module>paytech-platform-support-delivery</module>
        <module>paytech-platform-support-workflow</module>
        <module>paytech-platform-support-data-query</module>
        <module>paytech-platform-support-core</module>
        <module>paytech-platform-support-app</module>
        <module>paytech-platform-support-test</module>
    </modules>
</project>
