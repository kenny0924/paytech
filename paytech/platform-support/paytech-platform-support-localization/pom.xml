<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-platform-support</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paytech-platform-support-localization</artifactId>
    <name>PayTech Platform Support Localization</name>
    <description>Platform-owned UI text localization: locale catalog, applications and namespaces, key import, translations with ICU validation, immutable releases with language bundles and manifest delivery; no independent process or database.</description>
    <dependencies>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-platform-support-api</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-platform-support-access-control</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-platform-support-audit-security</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-platform-support-file-document</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-common-core</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-http-problem</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-redis-starter</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-snowflake-id</artifactId></dependency>
        <dependency><groupId>com.paytech</groupId><artifactId>paytech-compensation-event</artifactId></dependency>
        <dependency><groupId>com.ibm.icu</groupId><artifactId>icu4j</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
        <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis</artifactId></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><annotationProcessorPaths><path>
                    <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.46</version>
                </path></annotationProcessorPaths></configuration>
            </plugin>
        </plugins>
    </build>
</project>
