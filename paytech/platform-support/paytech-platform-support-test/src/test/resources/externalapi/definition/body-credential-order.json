{
  "params": [
    {"name": "apiKey", "dataType": "PROTECTED_HANDLE", "required": false}
  ],
  "fixedValues": {},
  "transport": {
    "protocol": "HTTP",
    "method": "POST",
    "endpointCode": "DEMO_GATEWAY",
    "pathTemplate": "/payments",
    "connectTimeoutMs": 2000,
    "responseTimeoutMs": 10000
  },
  "requestEncoding": "JSON",
  "responseDecoding": "JSON",
  "decimalEncoding": "NUMBER",
  "credentialFields": ["BODY:apiKey"],
  "scripts": [],
  "statusRules": [
    {"condition": "http.responseStatus == 200 && http.responseBody.code == 0", "executeStatus": "SUCCESS"}
  ],
  "outputs": {
    "SUCCESS": [
      {"name": "transactionRef", "dataType": "STRING", "required": true,
       "value": {"kind": "PATH", "path": "http.responseBody.payToken"}}
    ],
    "FAIL": []
  }
}
