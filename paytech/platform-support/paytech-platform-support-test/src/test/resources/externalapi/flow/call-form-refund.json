{
  "timeoutMs": 20000,
  "initializers": [
    {
      "id": "channelAccount",
      "function": "CHANNEL_ACCOUNT_CONFIG",
      "required": true,
      "args": {
        "vaultToken": {
          "kind": "PATH",
          "path": "input.paymentContext.vaultToken"
        },
        "channelCode": {
          "kind": "EXPRESSION",
          "expression": "'DEMO'"
        },
        "channelAccountId": {
          "kind": "PATH",
          "path": "input.paymentContext.attemptId"
        },
        "entityNo": {
          "kind": "PATH",
          "path": "input.paymentContext.attemptId"
        }
      }
    }
  ],
  "entry": "call",
  "nodes": [
    {
      "id": "call",
      "integrationApi": "CALL",
      "request": {
        "BODY:reason": {
          "kind": "EXPRESSION",
          "expression": "'customer request'"
        },
        "BODY:amount": {
          "kind": "PATH",
          "path": "input.paymentContext.amount"
        }
      },
      "params": {
        "username": {
          "kind": "PATH",
          "path": "resources.channelAccount.credentials.username"
        },
        "password": {
          "kind": "PATH",
          "path": "resources.channelAccount.credentials.apiKey"
        }
      }
    }
  ],
  "returns": [
    {
      "id": "done",
      "executeStatus": "SUCCESS",
      "outputs": {
        "paymentStatus": {
          "kind": "EXPRESSION",
          "expression": "'PAID'"
        },
        "transactionRef": {
          "kind": "PATH",
          "path": "steps.call.outputs.transactionRef"
        }
      }
    },
    {
      "id": "unknown",
      "executeStatus": "ERROR"
    }
  ],
  "edges": [
    {
      "from": "call",
      "to": "done",
      "condition": "steps.call.executeStatus == 'SUCCESS'",
      "priority": 1
    },
    {
      "from": "call",
      "to": "unknown",
      "default": true
    }
  ]
}
