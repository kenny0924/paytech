<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.platform.support.delivery.core.dal.mapper.NotificationTemplateMapper">
    <resultMap id="record" type="com.paytech.platform.support.delivery.core.dal.dataobject.NotificationTemplate">
        <id column="template_id" property="templateId"/>
        <result column="template_code" property="templateCode"/>
        <result column="medium" property="medium"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <sql id="columns">template_id, template_code, medium, status, version, create_time, update_time</sql>
    <sql id="filter">
        <where>
            <if test="keyword != null">template_code LIKE #{keyword} ESCAPE '!'</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </sql>
    <select id="find" resultMap="record">SELECT <include refid="columns"/> FROM t_notification_template WHERE template_id = #{id}</select>
    <select id="findCode" resultMap="record">SELECT <include refid="columns"/> FROM t_notification_template WHERE template_code = #{code}</select>
    <select id="findIds" resultMap="record">
        SELECT <include refid="columns"/> FROM t_notification_template WHERE template_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <select id="page" resultMap="record">
        SELECT <include refid="columns"/> FROM t_notification_template <include refid="filter"/>
        ORDER BY template_code LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">SELECT COUNT(*) FROM t_notification_template <include refid="filter"/></select>
    <insert id="insert">
        INSERT INTO t_notification_template (template_id, template_code, medium, status, version, create_time,
        update_time) VALUES (#{templateId}, #{templateCode}, #{medium}, #{status}, #{version}, #{createTime},
        #{updateTime})
    </insert>
    <update id="changeStatus">
        UPDATE t_notification_template SET status = #{status}, version = version + 1, update_time = #{now}
        WHERE template_id = #{item.templateId} AND version = #{item.version} AND status = #{item.status}
    </update>
</mapper>
