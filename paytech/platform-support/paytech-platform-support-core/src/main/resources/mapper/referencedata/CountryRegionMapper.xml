<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.platform.support.referencedata.core.dal.mapper.CountryRegionMapper">

    <select id="selectAll" timeout="2"
            resultType="com.paytech.platform.support.referencedata.core.dal.dataobject.CountryRegion">
        SELECT id, country_code AS countryCode, region_code AS regionCode, create_time AS createTime,
            update_time AS updateTime
        FROM t_country_region
        ORDER BY country_code
    </select>
</mapper>
