<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-platform-support</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paytech-platform-support-core</artifactId>
    <name>PayTech Platform Support Core</name>
    <description>Platform application orchestration: cross-module Processors and Services, internal token issuance, outbound adapters.</description>

    <dependencies>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-access-control</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-audit-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-file-document</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-delivery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-data-query</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-platform-support-localization</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-http-problem</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <!-- 内部签名 Token 签发与校验（D26）：签名器、声明、Purpose 与签发合同。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-internal-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>
        <!-- core 只依赖事件信封与发布端口（R8）；本步不实现消费者。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-messaging-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
