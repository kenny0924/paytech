<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-commercial</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Commercial</name>
    <description>Commercial service aggregator: agreements, commercial terms, payment method profiles and checkout context resolution.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commercial-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commercial-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-commercial-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-commercial-approved-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <!-- Copied from the CCT bans (design/09 §1.4); commercial has no MQ consumer or compensation handler, so AMQP, XXL and compensation stay banned. -->
                                    <excludes>
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-jdbc</exclude>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                        <exclude>com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-data-redis-reactive</exclude>
                                        <exclude>io.lettuce:*</exclude>
                                        <exclude>redis.clients:*</exclude>
                                        <exclude>org.redisson:*</exclude>
                                        <exclude>com.github.ben-manes.caffeine:*</exclude>
                                        <exclude>com.paytech:paytech-caffeine-starter</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-amqp</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>com.rabbitmq:*</exclude>
                                        <exclude>com.xuxueli:*</exclude>
                                        <exclude>com.paytech:paytech-redis-starter</exclude>
                                        <exclude>com.paytech:paytech-compensation-event</exclude>
                                        <exclude>com.paytech:paytech-xxl-job-starter</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-security</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-commercial-core</include>
                                        <include>com.paytech:paytech-commercial-app</include>
                                        <include>org.springframework.security:spring-security-crypto</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>paytech-commercial-api</module>
        <module>paytech-commercial-core</module>
        <module>paytech-commercial-app</module>
        <module>paytech-commercial-test</module>
    </modules>
</project>
