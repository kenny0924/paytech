<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.PricingProfileMapper">
    <resultMap id="PricingProfile" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$PricingProfile">
        <constructor>
            <arg column="pricing_profile_id" javaType="java.lang.Long"/>
            <arg column="pricing_profile_code" javaType="java.lang.String"/>
            <arg column="profile_kind" javaType="com.paytech.commercial.api.enums.PricingProfileKind"/>
            <arg column="payment_method_code" javaType="java.lang.String"/>
            <arg column="status" javaType="com.paytech.commercial.domain.enums.PricingProfileStatus"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="PricingProfile">
        SELECT pricing_profile_id, pricing_profile_code, profile_kind, payment_method_code, status
        FROM t_pricing_profile
        WHERE pricing_profile_code IN (SELECT pricing_profile_code FROM t_commercial_term_price WHERE term_price_id IN (SELECT term_price_id FROM t_commercial_term_price WHERE term_version_id IN (SELECT term_version_id FROM t_commercial_term_version WHERE term_plan_id IN (SELECT term_plan_id FROM t_commercial_term_plan WHERE client_id = #{clientId}<if test="!localPartnerIds.isEmpty()"> OR local_partner_id IN <foreach collection="localPartnerIds" item="partnerId" open="(" separator="," close=")">#{partnerId}</foreach></if>)) AND <choose><when test="entityNos.isEmpty()">1 = 0</when><otherwise>entity_no IN <foreach collection="entityNos" item="entityNo" open="(" separator="," close=")">#{entityNo}</foreach></otherwise></choose>))
        ORDER BY pricing_profile_id
    </select>

    <!-- 完整行映射：写入与按主键 / 唯一键 / 父读取；CheckoutRecords 只读投影另见 findForCheckout。 -->
    <resultMap id="PricingProfileRow" type="com.paytech.commercial.core.dal.dataobject.PricingProfile">
        <id column="pricing_profile_id" property="pricingProfileId"/>
        <result column="pricing_profile_code" property="pricingProfileCode"/>
        <result column="profile_name" property="profileName"/>
        <result column="profile_kind" property="profileKind"/>
        <result column="payment_method_code" property="paymentMethodCode"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="pricingProfileColumns">
        pricing_profile_id, pricing_profile_code, profile_name, profile_kind, payment_method_code, status,
        create_time, update_time
    </sql>

    <insert id="insert">
        INSERT INTO t_pricing_profile (<include refid="pricingProfileColumns"/>)
        VALUES (#{pricingProfileId}, #{pricingProfileCode}, #{profileName}, #{profileKind}, #{paymentMethodCode},
            #{status}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="PricingProfileRow">
        SELECT <include refid="pricingProfileColumns"/> FROM t_pricing_profile WHERE pricing_profile_id = #{pricingProfileId}
    </select>

    <select id="selectByCode" resultMap="PricingProfileRow">
        SELECT <include refid="pricingProfileColumns"/> FROM t_pricing_profile WHERE pricing_profile_code = #{pricingProfileCode}
    </select>

    <select id="selectByCodes" resultMap="PricingProfileRow">
        SELECT <include refid="pricingProfileColumns"/> FROM t_pricing_profile
        WHERE pricing_profile_code IN <foreach collection="pricingProfileCodes" item="value" open="(" separator="," close=")">#{value}</foreach>
        ORDER BY pricing_profile_id
    </select>

    <select id="selectByKindAndStatus" resultMap="PricingProfileRow">
        SELECT <include refid="pricingProfileColumns"/> FROM t_pricing_profile
        <where>
            <if test="profileKind != null">profile_kind = #{profileKind}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY pricing_profile_id
    </select>

    <update id="updateStatus">
        UPDATE t_pricing_profile SET status = #{status}, update_time = #{now}
        WHERE pricing_profile_id = #{row.pricingProfileId} AND status = #{row.status}
    </update>

    <update id="updateDraft">
        UPDATE t_pricing_profile SET profile_name = #{profileName}, profile_kind = #{profileKind},
            payment_method_code = #{paymentMethodCode}, update_time = #{now}
        WHERE pricing_profile_id = #{row.pricingProfileId} AND status = #{row.status} AND update_time = #{row.updateTime}
    </update>
</mapper>
