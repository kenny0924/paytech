<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.CommercialTermPlanMapper">
    <resultMap id="CommercialTermPlan" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$CommercialTermPlan">
        <constructor>
            <arg column="term_plan_id" javaType="java.lang.Long"/>
            <arg column="term_type" javaType="java.lang.String"/>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="local_partner_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.paytech.commercial.api.enums.CommercialTermPlanStatus"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="CommercialTermPlan">
        SELECT term_plan_id, term_type, agreement_id, entity_no, client_id, local_partner_id, status
        FROM t_commercial_term_plan
        WHERE owner_type &lt;&gt; 'PLATFORM_TEMPLATE'
          AND (client_id = #{clientId}<if test="!localPartnerIds.isEmpty()"> OR local_partner_id IN <foreach collection="localPartnerIds" item="partnerId" open="(" separator="," close=")">#{partnerId}</foreach></if>)
        ORDER BY term_plan_id
    </select>

    <!-- 完整行映射：写入与按主键 / 唯一键 / 父读取；CheckoutRecords 只读投影另见 findForCheckout。 -->
    <resultMap id="CommercialTermPlanRow" type="com.paytech.commercial.core.dal.dataobject.CommercialTermPlan">
        <id column="term_plan_id" property="termPlanId"/>
        <result column="plan_code" property="planCode"/>
        <result column="term_type" property="termType"/>
        <result column="owner_type" property="ownerType"/>
        <result column="template_name" property="templateName"/>
        <result column="agreement_id" property="agreementId"/>
        <result column="entity_no" property="entityNo"/>
        <result column="client_id" property="clientId"/>
        <result column="local_partner_id" property="localPartnerId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="commercialTermPlanColumns">
        term_plan_id, plan_code, term_type, owner_type, template_name, agreement_id, entity_no, client_id,
        local_partner_id, status, create_time, update_time
    </sql>

    <insert id="insert">
        INSERT INTO t_commercial_term_plan (<include refid="commercialTermPlanColumns"/>)
        VALUES (#{termPlanId}, #{planCode}, #{termType}, #{ownerType}, #{templateName}, #{agreementId}, #{entityNo},
            #{clientId}, #{localPartnerId}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan WHERE term_plan_id = #{termPlanId}
    </select>

    <select id="selectByTypeAndCode" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan WHERE term_type = #{termType} AND plan_code = #{planCode}
    </select>

    <select id="selectByAgreementAndType" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan WHERE agreement_id = #{agreementId} AND term_type = #{termType}
    </select>

    <select id="selectByPartnerAndType" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan WHERE local_partner_id = #{localPartnerId} AND term_type = #{termType}
    </select>

    <select id="selectByAgreementId" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan WHERE agreement_id = #{agreementId} ORDER BY term_plan_id
    </select>

    <update id="updateStatus">
        UPDATE t_commercial_term_plan SET status = #{status}, update_time = #{now}
        WHERE term_plan_id = #{row.termPlanId} AND status = #{row.status}
    </update>

    <!-- 合同方案列表不含标准价目模板（模板经 selectTemplates 读取）。 -->
    <sql id="listConditions">
        <where>
            owner_type &lt;&gt; 'PLATFORM_TEMPLATE'
            <if test="query.agreementId != null">AND agreement_id = #{query.agreementId}</if>
            <if test="query.clientId != null">AND client_id = #{query.clientId}</if>
            <if test="query.localPartnerId != null">AND local_partner_id = #{query.localPartnerId}</if>
            <if test="query.termType != null">AND term_type = #{query.termType}</if>
            <if test="query.status != null">AND status = #{query.status}</if>
        </where>
    </sql>

    <select id="selectPage" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan
        <include refid="listConditions"/>
        ORDER BY create_time DESC, term_plan_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM t_commercial_term_plan
        <include refid="listConditions"/>
    </select>

    <select id="selectTemplates" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan
        WHERE owner_type = 'PLATFORM_TEMPLATE'
            <if test="entityNo != null">AND entity_no = #{entityNo}</if>
            <if test="termType != null">AND term_type = #{termType}</if>
            <if test="status != null">AND status = #{status}</if>
        ORDER BY entity_no, plan_code
    </select>

    <select id="selectByIds" resultMap="CommercialTermPlanRow">
        SELECT <include refid="commercialTermPlanColumns"/> FROM t_commercial_term_plan
        WHERE term_plan_id IN <foreach collection="termPlanIds" item="termPlanId" open="(" separator="," close=")">#{termPlanId}</foreach>
        ORDER BY term_plan_id
    </select>
</mapper>
