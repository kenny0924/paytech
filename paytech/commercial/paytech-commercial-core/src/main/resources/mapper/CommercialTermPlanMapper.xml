<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.CommercialTermPlanMapper">
    <resultMap id="CommercialTermPlan" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$CommercialTermPlan">
        <constructor>
            <arg column="term_plan_id" javaType="java.lang.Long"/>
            <arg column="term_type" javaType="com.paytech.commercial.domain.enums.CommercialTermPlanTermType"/>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="local_partner_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="CommercialTermPlan">
        SELECT term_plan_id, term_type, agreement_id, entity_no, client_id, local_partner_id, status
        FROM t_commercial_term_plan
        WHERE client_id = #{clientId} OR local_partner_id IN (SELECT source_partner_id FROM t_entity_source_relation WHERE entity_no IN (SELECT entity_no FROM t_client_entity_affiliation WHERE client_id = #{clientId}) AND source_type='PARTNER')
        ORDER BY term_plan_id
    </select>
</mapper>
