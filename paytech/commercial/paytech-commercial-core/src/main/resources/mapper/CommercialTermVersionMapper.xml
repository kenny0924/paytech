<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.CommercialTermVersionMapper">
    <resultMap id="CommercialTermVersion" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$CommercialTermVersion">
        <constructor>
            <arg column="term_version_id" javaType="java.lang.Long"/>
            <arg column="term_plan_id" javaType="java.lang.Long"/>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.paytech.commercial.domain.enums.CommercialTermVersionStatus"/>
            <arg column="active_slot" javaType="java.lang.Integer"/>
            <arg column="effective_from" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="effective_to" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="CommercialTermVersion">
        SELECT term_version_id, term_plan_id, agreement_id, status, active_slot, effective_from, effective_to
        FROM t_commercial_term_version
        WHERE term_plan_id IN (SELECT term_plan_id FROM t_commercial_term_plan WHERE client_id = #{clientId} OR local_partner_id IN (SELECT source_partner_id FROM t_entity_source_relation WHERE entity_no IN (SELECT entity_no FROM t_client_entity_affiliation WHERE client_id = #{clientId}) AND source_type='PARTNER'))
        ORDER BY term_version_id
    </select>
</mapper>
