<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.CommercialTermVersionMapper">
    <resultMap id="CommercialTermVersion" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$CommercialTermVersion">
        <constructor>
            <arg column="term_version_id" javaType="java.lang.Long"/>
            <arg column="term_plan_id" javaType="java.lang.Long"/>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.paytech.commercial.domain.enums.CommercialTermVersionStatus"/>
            <arg column="active_slot" javaType="java.lang.Integer"/>
            <arg column="effective_from" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="effective_to" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="pricing_model" javaType="com.paytech.commercial.api.enums.PricingModel"/>
            <arg column="fee_tax_treatment" javaType="com.paytech.commercial.api.enums.FeeTaxTreatment"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="CommercialTermVersion">
        SELECT term_version_id, term_plan_id, agreement_id, status, active_slot, effective_from, effective_to, pricing_model, fee_tax_treatment
        FROM t_commercial_term_version
        WHERE term_plan_id IN (SELECT term_plan_id FROM t_commercial_term_plan WHERE owner_type &lt;&gt; 'PLATFORM_TEMPLATE' AND (client_id = #{clientId}<if test="!localPartnerIds.isEmpty()"> OR local_partner_id IN <foreach collection="localPartnerIds" item="partnerId" open="(" separator="," close=")">#{partnerId}</foreach></if>))
        ORDER BY term_version_id
    </select>

    <!-- 完整行映射：写入与按主键 / 唯一键 / 父读取；CheckoutRecords 只读投影另见 findForCheckout。 -->
    <resultMap id="CommercialTermVersionRow" type="com.paytech.commercial.core.dal.dataobject.CommercialTermVersion">
        <id column="term_version_id" property="termVersionId"/>
        <result column="term_plan_id" property="termPlanId"/>
        <result column="agreement_id" property="agreementId"/>
        <result column="version_no" property="versionNo"/>
        <result column="status" property="status"/>
        <result column="active_slot" property="activeSlot"/>
        <result column="effective_from" property="effectiveFrom"/>
        <result column="effective_to" property="effectiveTo"/>
        <result column="rounding_mode" property="roundingMode"/>
        <result column="pricing_model" property="pricingModel"/>
        <result column="fee_tax_treatment" property="feeTaxTreatment"/>
        <result column="source_template_version_id" property="sourceTemplateVersionId"/>
        <result column="signature_exempt" property="signatureExempt"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="commercialTermVersionColumns">
        term_version_id, term_plan_id, agreement_id, version_no, status, active_slot, effective_from,
        effective_to, rounding_mode, pricing_model, fee_tax_treatment, source_template_version_id, signature_exempt,
        create_time, update_time
    </sql>

    <insert id="insert">
        INSERT INTO t_commercial_term_version (<include refid="commercialTermVersionColumns"/>)
        VALUES (#{termVersionId}, #{termPlanId}, #{agreementId}, #{versionNo}, #{status}, #{activeSlot},
            #{effectiveFrom}, #{effectiveTo}, #{roundingMode}, #{pricingModel}, #{feeTaxTreatment},
            #{sourceTemplateVersionId}, #{signatureExempt}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version WHERE term_version_id = #{termVersionId}
    </select>

    <select id="selectByPlanAndVersionNo" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version WHERE term_plan_id = #{termPlanId} AND version_no = #{versionNo}
    </select>

    <select id="selectByPlanId" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version WHERE term_plan_id = #{termPlanId} ORDER BY version_no
    </select>

    <select id="selectMaxVersionNo" resultType="java.lang.Long">
        SELECT MAX(version_no) FROM t_commercial_term_version WHERE term_plan_id = #{termPlanId}
    </select>

    <select id="findEffectiveAt" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version
        WHERE term_plan_id = #{termPlanId} AND status IN ('SCHEDULED','ACTIVE','SUPERSEDED')
          AND effective_from &lt;= #{asOf} AND (effective_to IS NULL OR effective_to &gt; #{asOf})
        ORDER BY effective_from DESC, version_no DESC LIMIT 1
    </select>

    <select id="selectScheduledDue" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version
        WHERE status = 'SCHEDULED' AND effective_from &lt;= #{now}
        ORDER BY effective_from, term_version_id LIMIT #{limit}
    </select>

    <update id="updateStatus">
        UPDATE t_commercial_term_version SET status = #{status}, active_slot = #{activeSlot}, update_time = #{now}
        WHERE term_version_id = #{row.termVersionId} AND status = #{row.status}
    </update>

    <update id="updateEffectivePeriod">
        UPDATE t_commercial_term_version SET effective_from = #{effectiveFrom}, effective_to = #{effectiveTo}, update_time = #{now}
        WHERE term_version_id = #{row.termVersionId} AND status = #{row.status} AND update_time = #{row.updateTime}
    </update>

    <update id="updateSourceTemplate">
        UPDATE t_commercial_term_version SET source_template_version_id = #{sourceTemplateVersionId}, update_time = #{now}
        WHERE term_version_id = #{row.termVersionId} AND status = #{row.status} AND source_template_version_id IS NULL
    </update>

    <select id="selectByIds" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version
        WHERE term_version_id IN <foreach collection="termVersionIds" item="termVersionId" open="(" separator="," close=")">#{termVersionId}</foreach>
        ORDER BY term_version_id
    </select>

    <!-- 窗口 [windowFrom, windowTo) 与生效区间 [effective_from, effective_to) 相交；effective_to 为空表示无终点。 -->
    <sql id="listConditions">
        <where>
            <if test="query.planId != null">AND term_plan_id = #{query.planId}</if>
            <if test="query.agreementId != null">AND agreement_id = #{query.agreementId}</if>
            <if test="query.ownerType != null">
                AND term_plan_id IN (SELECT term_plan_id FROM t_commercial_term_plan WHERE owner_type = #{query.ownerType})
            </if>
            <if test="!query.statuses.isEmpty()">
                AND status IN <foreach collection="query.statuses" item="status" open="(" separator="," close=")">#{status}</foreach>
            </if>
            <if test="query.windowTo != null">AND effective_from &lt; #{query.windowTo}</if>
            <if test="query.windowFrom != null">AND (effective_to IS NULL OR effective_to &gt; #{query.windowFrom})</if>
        </where>
    </sql>

    <!-- 待审批按提交时刻（PENDING_APPROVAL 行的 update_time）升序；待生效按生效起点升序；其他按方案、版本号倒序。 -->
    <select id="selectPage" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version
        <include refid="listConditions"/>
        <choose>
            <when test="order == 'SUBMITTED'">ORDER BY update_time, term_version_id</when>
            <when test="order == 'EFFECTIVE'">ORDER BY effective_from, term_version_id</when>
            <otherwise>ORDER BY term_plan_id DESC, version_no DESC, term_version_id</otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM t_commercial_term_version
        <include refid="listConditions"/>
    </select>

    <select id="selectByPlanIdsAndStatuses" resultMap="CommercialTermVersionRow">
        SELECT <include refid="commercialTermVersionColumns"/> FROM t_commercial_term_version
        WHERE term_plan_id IN <foreach collection="termPlanIds" item="termPlanId" open="(" separator="," close=")">#{termPlanId}</foreach>
          AND status IN <foreach collection="statuses" item="status" open="(" separator="," close=")">#{status}</foreach>
        ORDER BY term_plan_id, version_no
    </select>
</mapper>
