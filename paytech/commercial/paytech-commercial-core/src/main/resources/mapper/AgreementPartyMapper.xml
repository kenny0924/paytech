<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.AgreementPartyMapper">
    <resultMap id="AgreementParty" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$AgreementParty">
        <constructor>
            <arg column="agreement_party_id" javaType="java.lang.Long"/>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="party_id" javaType="java.lang.Long"/>
            <arg column="party_profile_id" javaType="java.lang.Long"/>
            <arg column="party_role" javaType="com.paytech.commercial.domain.enums.AgreementPartyPartyRole"/>
            <arg column="acceptance_method" javaType="com.paytech.commercial.domain.enums.AgreementPartyAcceptanceMethod"/>
            <arg column="accepted_by_actor_id" javaType="java.lang.Long"/>
            <arg column="accepted_time" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="evidence_document_id" javaType="java.lang.Long"/>
            <arg column="acceptance_reference" javaType="java.lang.String"/>
            <arg column="acceptance_ref_slot" javaType="java.lang.Integer"/>
            <arg column="acceptance_recorded_by" javaType="java.lang.Long"/>
            <arg column="acceptance_recorded_at" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="AgreementParty">
        SELECT agreement_party_id, agreement_id, party_id, party_profile_id, party_role, acceptance_method, accepted_by_actor_id, accepted_time, evidence_document_id, acceptance_reference, acceptance_ref_slot, acceptance_recorded_by, acceptance_recorded_at
        FROM t_agreement_party
        WHERE agreement_id IN (SELECT agreement_id FROM t_agreement WHERE client_id = #{clientId}<if test="!localPartnerIds.isEmpty() and !entityNos.isEmpty()"> OR (local_partner_id IN <foreach collection="localPartnerIds" item="partnerId" open="(" separator="," close=")">#{partnerId}</foreach> AND agreement_id IN (SELECT agreement_id FROM t_agreement_operating_entity WHERE entity_no IN <foreach collection="entityNos" item="entityNo" open="(" separator="," close=")">#{entityNo}</foreach>))</if>)
        ORDER BY agreement_party_id
    </select>
    <!-- client-master 人员共享标记：任一合同参与方引用该 Party 或资料即视为已引用，不区分合同状态。 -->
    <select id="findReferencedPartyIds" resultType="java.lang.Long">
        SELECT DISTINCT party_id FROM t_agreement_party
        WHERE party_id IN <foreach collection="partyIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY party_id
    </select>
    <select id="findReferencedPartyProfileIds" resultType="java.lang.Long">
        SELECT DISTINCT party_profile_id FROM t_agreement_party
        WHERE party_profile_id IN <foreach collection="partyProfileIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY party_profile_id
    </select>

    <!-- 完整行映射：写入与按主键 / 唯一键 / 父读取；CheckoutRecords 只读投影另见 findForCheckout。 -->
    <resultMap id="AgreementPartyRow" type="com.paytech.commercial.core.dal.dataobject.AgreementParty">
        <id column="agreement_party_id" property="agreementPartyId"/>
        <result column="agreement_id" property="agreementId"/>
        <result column="party_id" property="partyId"/>
        <result column="party_profile_id" property="partyProfileId"/>
        <result column="party_role" property="partyRole"/>
        <result column="acceptance_method" property="acceptanceMethod"/>
        <result column="accepted_by_actor_id" property="acceptedByActorId"/>
        <result column="accepted_time" property="acceptedTime"/>
        <result column="evidence_document_id" property="evidenceDocumentId"/>
        <result column="acceptance_reference" property="acceptanceReference"/>
        <result column="acceptance_ref_slot" property="acceptanceRefSlot"/>
        <result column="acceptance_recorded_by" property="acceptanceRecordedBy"/>
        <result column="acceptance_recorded_at" property="acceptanceRecordedAt"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="agreementPartyColumns">
        agreement_party_id, agreement_id, party_id, party_profile_id, party_role, acceptance_method,
        accepted_by_actor_id, accepted_time, evidence_document_id, acceptance_reference, acceptance_ref_slot,
        acceptance_recorded_by, acceptance_recorded_at, create_by, create_time, update_time
    </sql>

    <insert id="insertAll">
        INSERT INTO t_agreement_party (<include refid="agreementPartyColumns"/>) VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{row.agreementPartyId}, #{row.agreementId}, #{row.partyId}, #{row.partyProfileId}, #{row.partyRole}, #{row.acceptanceMethod}, #{row.acceptedByActorId}, #{row.acceptedTime}, #{row.evidenceDocumentId}, #{row.acceptanceReference}, #{row.acceptanceRefSlot}, #{row.acceptanceRecordedBy}, #{row.acceptanceRecordedAt}, #{row.createBy}, #{row.createTime}, #{row.updateTime})
        </foreach>
    </insert>

    <select id="selectById" resultMap="AgreementPartyRow">
        SELECT <include refid="agreementPartyColumns"/> FROM t_agreement_party WHERE agreement_party_id = #{agreementPartyId}
    </select>

    <select id="selectByUniqueKey" resultMap="AgreementPartyRow">
        SELECT <include refid="agreementPartyColumns"/> FROM t_agreement_party WHERE agreement_id = #{agreementId} AND party_id = #{partyId} AND party_role = #{partyRole}
    </select>

    <select id="selectByAgreementId" resultMap="AgreementPartyRow">
        SELECT <include refid="agreementPartyColumns"/> FROM t_agreement_party WHERE agreement_id = #{agreementId} ORDER BY agreement_party_id
    </select>

    <select id="selectByAcceptanceReference" resultMap="AgreementPartyRow">
        SELECT <include refid="agreementPartyColumns"/> FROM t_agreement_party WHERE acceptance_reference = #{acceptanceReference} ORDER BY agreement_party_id
    </select>

    <update id="updateAcceptance">
        UPDATE t_agreement_party SET acceptance_method = #{acceptance.acceptanceMethod}, accepted_by_actor_id = #{acceptance.acceptedByActorId}, accepted_time = #{acceptance.acceptedTime}, evidence_document_id = #{acceptance.evidenceDocumentId}, acceptance_reference = #{acceptance.acceptanceReference}, acceptance_ref_slot = #{acceptance.acceptanceRefSlot}, acceptance_recorded_by = #{acceptance.acceptanceRecordedBy}, acceptance_recorded_at = #{acceptance.acceptanceRecordedAt},
            update_time = #{now}
        WHERE agreement_party_id = #{row.agreementPartyId} AND accepted_time IS NULL
    </update>
</mapper>
