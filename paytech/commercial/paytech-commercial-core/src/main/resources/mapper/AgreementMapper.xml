<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commercial.core.dal.mapper.AgreementMapper">
    <resultMap id="Agreement" type="com.paytech.commercial.core.dal.dataobject.CheckoutRecords$Agreement">
        <constructor>
            <arg column="agreement_id" javaType="java.lang.Long"/>
            <arg column="agreement_type" javaType="com.paytech.commercial.domain.enums.AgreementAgreementType"/>
            <arg column="business_mode" javaType="com.paytech.commercial.api.enums.BusinessMode"/>
            <arg column="fund_mode" javaType="com.paytech.commercial.api.enums.FundMode"/>
            <arg column="pricing_authority" javaType="com.paytech.commercial.api.enums.PricingAuthority"/>
            <arg column="referral_partner_id" javaType="java.lang.Long"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="local_partner_id" javaType="java.lang.Long"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="agreement_format" javaType="com.paytech.commercial.domain.enums.AgreementAgreementFormat"/>
            <arg column="status" javaType="com.paytech.commercial.domain.enums.AgreementStatus"/>
            <arg column="effective_from" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="effective_to" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="signed_time" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="activated_time" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="Agreement">
        SELECT agreement_id, agreement_type, business_mode, fund_mode, pricing_authority, referral_partner_id, client_id, local_partner_id, entity_no, agreement_format, status, effective_from, effective_to, signed_time, activated_time
        FROM t_agreement
        WHERE client_id = #{clientId}<if test="!localPartnerIds.isEmpty() and !entityNos.isEmpty()"> OR (local_partner_id IN <foreach collection="localPartnerIds" item="partnerId" open="(" separator="," close=")">#{partnerId}</foreach> AND agreement_id IN (SELECT agreement_id FROM t_agreement_operating_entity WHERE entity_no IN <foreach collection="entityNos" item="entityNo" open="(" separator="," close=")">#{entityNo}</foreach>))</if>
        ORDER BY agreement_id
    </select>

    <!-- 完整行映射：写入与按主键 / 唯一键 / 父读取；CheckoutRecords 只读投影另见 findForCheckout。 -->
    <resultMap id="AgreementRow" type="com.paytech.commercial.core.dal.dataobject.Agreement">
        <id column="agreement_id" property="agreementId"/>
        <result column="agreement_no" property="agreementNo"/>
        <result column="agreement_name" property="agreementName"/>
        <result column="agreement_type" property="agreementType"/>
        <result column="business_mode" property="businessMode"/>
        <result column="fund_mode" property="fundMode"/>
        <result column="pricing_authority" property="pricingAuthority"/>
        <result column="referral_partner_id" property="referralPartnerId"/>
        <result column="client_id" property="clientId"/>
        <result column="local_partner_id" property="localPartnerId"/>
        <result column="entity_no" property="entityNo"/>
        <result column="agreement_format" property="agreementFormat"/>
        <result column="status" property="status"/>
        <result column="effective_from" property="effectiveFrom"/>
        <result column="effective_to" property="effectiveTo"/>
        <result column="signed_time" property="signedTime"/>
        <result column="activated_time" property="activatedTime"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="agreementColumns">
        agreement_id, agreement_no, agreement_name, agreement_type, business_mode, fund_mode,
        pricing_authority, referral_partner_id, client_id, local_partner_id, entity_no, agreement_format,
        status, effective_from, effective_to, signed_time, activated_time, create_by, create_time, update_time
    </sql>

    <insert id="insert">
        INSERT INTO t_agreement (<include refid="agreementColumns"/>)
        VALUES (#{agreementId}, #{agreementNo}, #{agreementName}, #{agreementType}, #{businessMode}, #{fundMode},
            #{pricingAuthority}, #{referralPartnerId}, #{clientId}, #{localPartnerId}, #{entityNo},
            #{agreementFormat}, #{status}, #{effectiveFrom}, #{effectiveTo}, #{signedTime}, #{activatedTime},
            #{createBy}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="AgreementRow">
        SELECT <include refid="agreementColumns"/> FROM t_agreement WHERE agreement_id = #{agreementId}
    </select>

    <select id="selectByAgreementNo" resultMap="AgreementRow">
        SELECT <include refid="agreementColumns"/> FROM t_agreement WHERE agreement_no = #{agreementNo}
    </select>

    <select id="selectByClientId" resultMap="AgreementRow">
        SELECT <include refid="agreementColumns"/> FROM t_agreement WHERE client_id = #{clientId} ORDER BY agreement_id
    </select>

    <select id="selectByLocalPartnerId" resultMap="AgreementRow">
        SELECT <include refid="agreementColumns"/> FROM t_agreement WHERE local_partner_id = #{localPartnerId} ORDER BY agreement_id
    </select>

    <update id="updateStatus">
        UPDATE t_agreement SET status = #{status}, update_time = #{now}
        WHERE agreement_id = #{row.agreementId} AND status = #{row.status}
    </update>

    <update id="updateLifecycle">
        UPDATE t_agreement SET status = #{status}, effective_to = #{effectiveTo}, signed_time = #{signedTime},
            activated_time = #{activatedTime}, update_time = #{now}
        WHERE agreement_id = #{row.agreementId} AND status = #{row.status}
    </update>
</mapper>
