<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-commercial</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paytech-commercial-core</artifactId>
    <name>PayTech Commercial Core</name>
    <description>Commercial business implementation: two-stage checkout context resolution over agreements, terms and payment method profiles.</description>

    <dependencies>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-commercial-api</artifactId>
        </dependency>
        <!-- Checkout candidates, verification and party profiles (HTTP contract only). -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-client-master-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-mybatis-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-http-problem</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 写入 Processor 的资源锁 AbstractLockProcessor（technique.md §2.2）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-redis-starter</artifactId>
        </dependency>
        <!-- 事件发布任务：本地 compensation_event 登记与发布 Handler（technique.md §2.8）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-compensation-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-messaging-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- BCR 快照完整性哈希的 RFC 8785 规范化输入（DATABASE_DESIGN_GUIDE §9.1；B 线写入 Service）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-json-canonicalization</artifactId>
        </dependency>
        <!-- 写入 Processor / Service 为新行准备 Snowflake 主键（实现由 app 装配）。 -->
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-snowflake-id</artifactId>
        </dependency>
        <!-- CommercialEventProperties（@ConfigurationProperties / @Validated）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
    </dependencies>

    <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><annotationProcessorPaths><path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></path></annotationProcessorPaths></configuration>
            </plugin></plugins></build>
</project>
