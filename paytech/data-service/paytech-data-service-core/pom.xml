<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-data-service-core</artifactId>
    <packaging>jar</packaging>

    <name>PayTech Data Service Core</name>
    <description>CDC whitelist catalog of the data service; no Mapper and no business query yet.</description>

    <dependencies>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-data-service-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The public whitelist contract lives once at paytech/data-service/cdc; package it as classpath:cdc/whitelist.yaml. -->
            <resource>
                <directory>${project.basedir}/../cdc</directory>
                <targetPath>cdc</targetPath>
                <includes>
                    <include>whitelist.yaml</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
