<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../build/paytech-parent/pom.xml</relativePath>
    </parent>

    <artifactId>paytech-reconciliation</artifactId>
    <packaging>pom</packaging>

    <name>PayTech Reconciliation</name>
    <description>Reconciliation service aggregator: channel clearing accounts, platform transactions, channel statements, bank statements, expected bank movements, exceptions and resolutions (2026-10-20 slice 1).</description>

    <modules>
        <module>paytech-reconciliation-api</module>
        <module>paytech-reconciliation-core</module>
        <module>paytech-reconciliation-app</module>
        <module>paytech-reconciliation-test</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reconciliation-bootstrap-scope</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- No other service's core/app; cross-service calls go through *-api only (D09). -->
                                        <exclude>com.paytech:*-core</exclude>
                                        <exclude>com.paytech:*-app</exclude>
                                        <!-- Finance bans copied from 09 §1.4. The 2026-10-20 reconciliation slice 1 (REQ technique 2.8) reopens AMQP,
                                             RabbitMQ, compensation-event, XXL-Job and Nacos discovery / config: reconciliation consumes
                                             BillingFactRecorded, publishes its four events through paytech-messaging, runs the line wait
                                             expiry job and calls channel-connector and Vault through service discovery. -->
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                    </excludes>
                                    <includes>
                                        <!-- Foundation, not a service core. -->
                                        <include>com.paytech:paytech-common-core</include>
                                        <include>com.paytech:paytech-reconciliation-api</include>
                                        <include>com.paytech:paytech-reconciliation-core</include>
                                        <include>com.paytech:paytech-reconciliation-app</include>
                                        <include>com.paytech:paytech-reconciliation-test</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
