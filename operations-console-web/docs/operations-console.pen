                            {
                              "type": "text",
                              "id": "d3CM8",
                              "name": "代码行1",
                              "fill": "#D7DEEA",
                              "content": "let body = http.requestBody;",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "t851S",
                              "name": "代码行2",
                              "fill": "#D7DEEA",
                              "content": "let sig = functions.hmacSha256(params.key, json.canonical(body));",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "aKZd8",
                              "name": "代码行3",
                              "fill": "#D7DEEA",
                              "content": "http.requestHeaders.set(",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "eFUiT",
                              "name": "代码行4",
                              "fill": "#D7DEEA",
                              "content": "    params.headerName ?? 'Authorization',",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "BeaZT",
                              "name": "代码行5",
                              "fill": "#D7DEEA",
                              "content": "    'NI-HMAC ' + sig);",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "xOOiW",
                              "name": "代码行6",
                              "fill": "#D7DEEA",
                              "content": "functions.lockRequestBody();",
                              "lineHeight": 1.5,
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
