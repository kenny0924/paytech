              ],
              "children": [
                {
                  "type": "text",
                  "id": "Il19F",
                  "name": "一句话-1",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "billing 是「算钱并把结果定格成事实」的服务：任何会改变 Client、合作伙伴、平台或银行现金余额的金额，先在 billing 变成一条不可变、带版本的经济事实，再由 account 记明细账、ledger 记总账。",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "NjxqL",
                  "name": "一句话-2",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "billing 不管余额（account）、不管分录（ledger）、不定价格（CCT / 商务）、不算税（税务）、不确认渠道实收（对账）。",
                  "lineHeight": 1.5,
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
