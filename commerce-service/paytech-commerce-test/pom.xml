<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-commerce-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paytech-commerce-test</artifactId>
    <name>Commerce Test</name>
    <description>Isolated Commerce automated tests.</description>

    <properties>
        <commerce.checkout.coverage.minimum>0.90</commerce.checkout.coverage.minimum>
        <jacoco.agent.argLine/>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
            <dependency>
                <groupId>com.paytech</groupId>
                <artifactId>paytech-payment-api</artifactId>
            </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>paytech-commerce-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacoco.agent.argLine}</argLine>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables>
                        <commerce.reactor.root>${project.basedir}/..</commerce.reactor.root>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-commerce-http-coverage</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <append>false</append>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <propertyName>jacoco.agent.argLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-commerce-checkout-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                            <includes>
                                <include>com/paytech/commerce/core/dal/dataobject/refund/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/mapper/refund/**/*.class</include>
                                <include>com/paytech/commerce/domain/refund/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/repository/refund/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/service/refund/**/*.class</include>
                                <include>com/paytech/commerce/ext/rest/external/clientapi/v1/refund/**/*.class</include>
                                <include>com/paytech/commerce/ext/job/**/*.class</include>
                                <include>com/paytech/commerce/service/processor/refund/**/*.class</include>
                                <include>com/paytech/commerce/configuration/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/dataobject/customer/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/mapper/customer/**/*.class</include>
                                <include>com/paytech/commerce/domain/customer/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/repository/customer/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/service/customer/**/*.class</include>
                                <include>com/paytech/commerce/ext/rest/external/customerapi/**/*.class</include>
                                <include>com/paytech/commerce/ext/rest/internal/customer/**/*.class</include>
                                <include>com/paytech/commerce/service/processor/customer/**/*.class</include>

                                <include>com/paytech/commerce/core/dal/dataobject/checkout/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/dataobject/order/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/mapper/checkout/**/*.class</include>
                                <include>com/paytech/commerce/core/dal/mapper/order/**/*.class</include>
                                <include>com/paytech/commerce/domain/checkout/**/*.class</include>
                                <include>com/paytech/commerce/domain/enums/**/*.class</include>
                                <include>com/paytech/commerce/domain/order/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/port/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/repository/order/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/repository/checkout/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/service/order/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/service/checkout/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/service/idempotency/**/*.class</include>
                                <include>com/paytech/commerce/domainservice/validator/**/*.class</include>
                                <include>com/paytech/commerce/ext/rest/external/clientapi/v1/order/**/*.class</include>
                                <include>com/paytech/commerce/ext/rest/external/clientapi/v1/checkout/**/*.class
                                </include>
                                <include>com/paytech/commerce/ext/rest/external/clientapi/v1/filter/**/*.class</include>
                                <include>com/paytech/commerce/integration/**/*.class</include>
                                <include>com/paytech/commerce/service/processor/order/**/*.class</include>
                                <include>com/paytech/commerce/service/processor/checkout/**/*.class</include>
                                <include>com/paytech/commerce/service/transaction/**/*.class</include>
                            </includes>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate</outputDirectory>
                            <title>Commerce Checkout, Orders and Refunds HTTP Coverage</title>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.jacoco</groupId>
                        <artifactId>org.jacoco.ant</artifactId>
                        <version>${jacoco-maven-plugin.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>reset-commerce-http-coverage-data</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.directory}/jacoco.exec" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-commerce-checkout-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:jacoco="antlib:org.jacoco.ant">
                                <property name="commerce.checkout.classes"
                                          location="${project.basedir}/../paytech-commerce-web/target/classes"/>
                                <property name="commerce.checkout.execution.data"
                                          location="${project.build.directory}/jacoco.exec"/>

                                <available file="${commerce.checkout.classes}"
                                           type="dir"
                                           property="commerce.checkout.classes.available"/>
                                <fail unless="commerce.checkout.classes.available"
                                      message="Hosted Checkout classes are missing. Run verify from the commerce reactor so paytech-commerce-web is built first."/>
                                <available file="${commerce.checkout.execution.data}"
                                           type="file"
                                           property="commerce.checkout.execution.data.available"/>
                                <fail unless="commerce.checkout.execution.data.available"
                                      message="Hosted Checkout coverage data is missing. The real HTTP auto tests must execute before the coverage gate."/>

                                <taskdef uri="antlib:org.jacoco.ant"
                                         resource="org/jacoco/ant/antlib.xml"/>
                                <jacoco:report>
                                    <executiondata>
                                        <file file="${commerce.checkout.execution.data}"/>
                                    </executiondata>
                                    <structure name="Commerce Hosted Checkout">
                                        <classfiles>
                                            <fileset dir="${commerce.checkout.classes}">
                                                <include name="com/paytech/commerce/core/dal/dataobject/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/core/dal/mapper/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/domain/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/repository/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/service/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/ext/rest/external/clientapi/v1/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/ext/job/**/*.class"/>
                                                <include name="com/paytech/commerce/service/processor/refund/**/*.class"/>
                                                <include name="com/paytech/commerce/configuration/**/*.class"/>
                                                <include name="com/paytech/commerce/core/dal/dataobject/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/core/dal/mapper/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/domain/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/repository/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/service/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/ext/rest/external/customerapi/**/*.class"/>
                                                <include name="com/paytech/commerce/ext/rest/internal/customer/**/*.class"/>
                                                <include name="com/paytech/commerce/service/processor/customer/**/*.class"/>

                                                <include
                                                        name="com/paytech/commerce/core/dal/dataobject/checkout/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/core/dal/dataobject/order/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/core/dal/mapper/checkout/**/*.class"/>
                                                <include name="com/paytech/commerce/core/dal/mapper/order/**/*.class"/>
                                                <include name="com/paytech/commerce/domain/checkout/**/*.class"/>
                                                <include name="com/paytech/commerce/domain/enums/**/*.class"/>
                                                <include name="com/paytech/commerce/domain/order/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/port/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/domainservice/repository/order/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/repository/checkout/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/domainservice/service/order/**/*.class"/>
                                                <include name="com/paytech/commerce/domainservice/service/checkout/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/domainservice/service/idempotency/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/domainservice/validator/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/ext/rest/external/clientapi/v1/order/**/*.class"/>
                                                <include name="com/paytech/commerce/ext/rest/external/clientapi/v1/checkout/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/ext/rest/external/clientapi/v1/filter/**/*.class"/>
                                                <include name="com/paytech/commerce/integration/**/*.class"/>
                                                <include
                                                        name="com/paytech/commerce/service/processor/order/**/*.class"/>
                                                <include name="com/paytech/commerce/service/processor/checkout/**/*.class"/>
                                                <include name="com/paytech/commerce/service/transaction/**/*.class"/>
                                            </fileset>
                                        </classfiles>
                                    </structure>
                                    <check>
                                        <rule element="BUNDLE">
                                            <limit counter="LINE"
                                                   value="TOTALCOUNT"
                                                   minimum="1"/>
                                            <limit counter="LINE"
                                                   value="COVEREDRATIO"
                                                   minimum="${commerce.checkout.coverage.minimum}"/>
                                        </rule>
                                    </check>
                                </jacoco:report>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 显式限定 CreateCheckout 的测试及辅助类编译范围；默认 auto 也仅保留创建测试。 -->
    <profiles>
        <profile>
            <id>checkout-create-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testIncludes>
                                <testInclude>com/paytech/commerce/TestApplication.java</testInclude>
                                <testInclude>com/paytech/commerce/test/base/MockTestBase.java</testInclude>
                                <testInclude>com/paytech/commerce/test/base/checkout/AbstractCreateCheckoutApiTest.java</testInclude>
                                <testInclude>com/paytech/commerce/test/builder/**/*.java</testInclude>
                                <testInclude>com/paytech/commerce/test/checker/**/*.java</testInclude>
                                <testInclude>com/paytech/commerce/test/mocker/**/*.java</testInclude>
                                <testInclude>com/paytech/commerce/test/mock/**/*.java</testInclude>
                                <testInclude>com/paytech/commerce/test/dal/*.java</testInclude>
                                <testInclude>com/paytech/commerce/test/checkout/AdjustableUtcClock.java</testInclude>
                                <testInclude>com/paytech/commerce/test/checkout/CctTransactionProbe.java</testInclude>
                                <testInclude>com/paytech/commerce/auto/ext/http/clientapi/v1/checkout/create/*Test.java</testInclude>
                                <testInclude>com/paytech/commerce/auto/domainservice/checkout/CheckoutCreationTransactionTest.java</testInclude>
                            </testIncludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/auto/ext/http/clientapi/v1/checkout/create/*Test.java</include>
                                <include>**/auto/**/CheckoutCreationTransactionTest.java</include>
                            </includes>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
