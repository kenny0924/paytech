<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.commerce.core.dal.mapper.order.OrderPaymentProjectionMapper">
    <resultMap id="OrderPaymentProjection" type="com.paytech.commerce.core.dal.dataobject.order.OrderPaymentProjection">
        <id column="order_payment_projection_id" property="orderPaymentProjectionId" javaType="_long"/>
        <result column="order_id" property="orderId" javaType="_long"/>
        <result column="payment_intent_id" property="paymentIntentId" javaType="_long"/>
        <result column="intent_status" property="intentStatus" javaType="com.paytech.commerce.domain.enums.PaymentIntentStatus"/>
        <result column="successful_attempt_id" property="successfulAttemptId" javaType="java.lang.Long"/>
        <result column="captured_amount" property="capturedAmount" javaType="java.math.BigDecimal"/>
        <result column="currency" property="currency" javaType="java.lang.String"/>
        <result column="intent_source_version" property="intentSourceVersion"/>
        <result column="create_time" property="createTime"/>
        <result column="version" property="version" javaType="_long"/>
    </resultMap>
    <select id="findByOrderId" resultMap="OrderPaymentProjection">
        SELECT order_payment_projection_id,order_id,payment_intent_id,intent_status,successful_attempt_id,
            captured_amount,currency,version,intent_source_version,create_time
        FROM t_order_payment_projection WHERE order_id=#{orderId}
    </select>
    <select id="findVersionByOrderId" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT version FROM t_order_payment_projection WHERE order_id=#{orderId}
    </select>
    <insert id="insert">
        INSERT INTO t_order_payment_projection (order_payment_projection_id,order_id,payment_intent_id,intent_status,
            intent_source_version,captured_amount,currency,last_event_time,version,create_time,update_time)
        VALUES (#{orderPaymentProjectionId},#{orderId},#{paymentIntentId},#{intentStatus},#{intentSourceVersion},
            #{capturedAmount},#{currency},#{createTime},#{version},#{createTime},#{createTime})
    </insert>
</mapper>
