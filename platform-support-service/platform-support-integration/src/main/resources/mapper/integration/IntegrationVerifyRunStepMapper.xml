<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.platform.support.integration.core.dal.mapper.IntegrationVerifyRunStepMapper">
    <sql id="columns">verify_run_step_id verifyRunStepId, verify_run_id verifyRunId, step_no stepNo, step_key stepKey, standard_api_code standardApiCode, step_status stepStatus, resolved_input_json resolvedInputJson, result_json resultJson, assertions_json assertionsJson, trace_json traceJson, elapsed_ms elapsedMs, create_time createTime</sql>
    <select id="byRun" resultType="com.paytech.platform.support.integration.core.dal.dataobject.IntegrationVerifyRunStep" useCache="false">
        SELECT <include refid="columns"/> FROM t_integration_verify_run_step WHERE verify_run_id=#{verifyRunId} ORDER BY step_no
    </select>
    <insert id="insertAll">
        INSERT INTO t_integration_verify_run_step(verify_run_step_id,verify_run_id,step_no,step_key,standard_api_code,step_status,resolved_input_json,result_json,assertions_json,trace_json,elapsed_ms,create_time) VALUES
        <foreach collection="rows" item="row" separator=",">
        (#{row.verifyRunStepId},#{row.verifyRunId},#{row.stepNo},#{row.stepKey},#{row.standardApiCode},#{row.stepStatus},#{row.resolvedInputJson},#{row.resultJson},#{row.assertionsJson},#{row.traceJson},#{row.elapsedMs},#{row.createTime})
        </foreach>
    </insert>
</mapper>
