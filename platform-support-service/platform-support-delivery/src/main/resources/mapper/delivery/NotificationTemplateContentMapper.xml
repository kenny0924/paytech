<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.platform.support.delivery.core.dal.mapper.NotificationTemplateContentMapper">
    <resultMap id="record" type="com.paytech.platform.support.delivery.core.dal.dataobject.NotificationTemplateContent">
        <id column="content_id" property="contentId"/>
        <result column="template_id" property="templateId"/>
        <result column="locale" property="locale"/>
        <result column="subject_template" property="subjectTemplate"/>
        <result column="body_template" property="bodyTemplate"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <select id="find" resultMap="record">SELECT content_id, template_id, locale, subject_template, body_template, version, create_time, update_time FROM t_notification_template_content WHERE content_id = #{id}</select>
    <select id="findLocale" resultMap="record">SELECT content_id, template_id, locale, subject_template, body_template, version, create_time, update_time FROM t_notification_template_content WHERE template_id = #{templateId} AND locale = #{locale}</select>
</mapper>
