<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.platform.support.delivery.core.dal.mapper.NotificationTemplateMapper">
    <resultMap id="record" type="com.paytech.platform.support.delivery.core.dal.dataobject.NotificationTemplate">
        <id column="template_id" property="templateId"/>
        <result column="template_code" property="templateCode"/>
        <result column="medium" property="medium"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <select id="find" resultMap="record">SELECT template_id, template_code, medium, status, version, create_time, update_time FROM t_notification_template WHERE template_id = #{id}</select>
    <select id="findCode" resultMap="record">SELECT template_id, template_code, medium, status, version, create_time, update_time FROM t_notification_template WHERE template_code = #{code}</select>
</mapper>
