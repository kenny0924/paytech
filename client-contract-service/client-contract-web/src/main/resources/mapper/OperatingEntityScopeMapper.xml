<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.contract.core.dal.mapper.OperatingEntityScopeMapper">
    <resultMap id="OperatingEntityScope" type="com.paytech.client.contract.core.dal.dataobject.CheckoutRecords$OperatingEntityScope">
        <constructor>
            <arg column="scope_id" javaType="java.lang.Long"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="application_id" javaType="java.lang.Long"/>
            <arg column="consumer_country_code" javaType="java.lang.String"/>
            <arg column="currency" javaType="java.lang.String"/>
            <arg column="industry_code" javaType="java.lang.String"/>
            <arg column="mcc_code" javaType="java.lang.String"/>
            <arg column="status" javaType="com.paytech.client.contract.domain.enums.OperatingEntityScopeStatus"/>
            <arg column="active_slot" javaType="java.lang.Integer"/>
            <arg column="effective_from" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="effective_to" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findForCheckout" resultMap="OperatingEntityScope">
        SELECT scope_id, entity_no, application_id, consumer_country_code, currency, industry_code, mcc_code, status, active_slot, effective_from, effective_to
        FROM t_operating_entity_scope
        WHERE entity_no IN (SELECT entity_no FROM t_client_entity_affiliation WHERE client_id = #{clientId})
        ORDER BY scope_id
    </select>
</mapper>
