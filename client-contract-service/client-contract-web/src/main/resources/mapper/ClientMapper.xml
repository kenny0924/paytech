<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.contract.core.dal.mapper.ClientMapper">
    <resultMap id="Client" type="com.paytech.client.contract.core.dal.dataobject.CheckoutRecords$Client">
        <constructor>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="party_id" javaType="java.lang.Long"/>
            <arg column="status" javaType="com.paytech.client.contract.domain.enums.ClientStatus"/>
        </constructor>
    </resultMap>
    <select id="findById" resultMap="Client">
        SELECT client_id, party_id, status
        FROM t_client
        WHERE client_id = #{clientId}
        ORDER BY client_id
    </select>
</mapper>
