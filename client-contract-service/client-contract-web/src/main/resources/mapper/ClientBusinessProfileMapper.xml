<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.contract.core.dal.mapper.ClientBusinessProfileMapper">
    <resultMap id="ClientBusinessProfile" type="com.paytech.client.contract.core.dal.dataobject.CheckoutRecords$ClientBusinessProfile">
        <constructor>
            <arg column="business_profile_id" javaType="java.lang.Long"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="content_hash" javaType="java.lang.String"/>
            <arg column="classification_case_id" javaType="java.lang.Long"/>
            <arg column="classification_confirmed_by" javaType="java.lang.Long"/>
            <arg column="classification_confirmed_time" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findByClientId" resultMap="ClientBusinessProfile">
        SELECT business_profile_id, client_id, content_hash, classification_case_id, classification_confirmed_by, classification_confirmed_time
        FROM t_client_business_profile
        WHERE client_id = #{clientId}
        ORDER BY business_profile_id
    </select>
</mapper>
