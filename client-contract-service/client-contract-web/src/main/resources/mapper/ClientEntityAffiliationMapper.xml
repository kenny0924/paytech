<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.client.contract.core.dal.mapper.ClientEntityAffiliationMapper">
    <resultMap id="ClientEntityAffiliation" type="com.paytech.client.contract.core.dal.dataobject.CheckoutRecords$ClientEntityAffiliation">
        <constructor>
            <arg column="affiliation_id" javaType="java.lang.Long"/>
            <arg column="client_id" javaType="java.lang.Long"/>
            <arg column="entity_no" javaType="java.lang.String"/>
            <arg column="priority_no" javaType="java.lang.Integer"/>
            <arg column="status" javaType="com.paytech.client.contract.domain.enums.ClientEntityAffiliationStatus"/>
            <arg column="active_slot" javaType="java.lang.Integer"/>
            <arg column="effective_from" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
            <arg column="effective_to" javaType="java.time.Instant" typeHandler="com.paytech.foundation.mybatis.typehandler.InstantTypeHandler"/>
        </constructor>
    </resultMap>
    <select id="findByClientId" resultMap="ClientEntityAffiliation">
        SELECT affiliation_id, client_id, entity_no, priority_no, status, active_slot, effective_from, effective_to
        FROM t_client_entity_affiliation
        WHERE client_id = #{clientId}
        ORDER BY affiliation_id
    </select>
</mapper>
