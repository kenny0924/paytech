<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paytech.finance.accounting.core.dal.mapper.ChannelCostPlanMapper">
    <sql id="columns">id, channel_id, plan_code, current_ver_id, status, version, create_time, update_time</sql>

    <insert id="insert">
        INSERT INTO t_channel_cost_plan (<include refid="columns"/>)
        VALUES (#{id}, #{channelId}, #{planCode}, #{currentVerId}, #{status}, #{version}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectByCode" resultType="com.paytech.finance.accounting.core.dal.dataobject.ChannelCostPlan">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE plan_code = #{planCode}
    </select>

    <select id="selectByChannelId" resultType="com.paytech.finance.accounting.core.dal.dataobject.ChannelCostPlan">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE channel_id = #{channelId}
    </select>

    <select id="selectByCodeForUpdate" resultType="com.paytech.finance.accounting.core.dal.dataobject.ChannelCostPlan">
        SELECT <include refid="columns"/> FROM t_channel_cost_plan WHERE plan_code = #{planCode} FOR UPDATE
    </select>

    <update id="updateCurrentVersion">
        UPDATE t_channel_cost_plan
        SET current_ver_id = #{currentVerId}, status = 'ACTIVE', version = version + 1, update_time = #{now}
        WHERE id = #{plan.id} AND version = #{plan.version}
    </update>
</mapper>
