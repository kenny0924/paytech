<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.paytech</groupId>
        <artifactId>paytech-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <artifactId>risk-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Risk Service</name>

    <modules>
        <module>risk-api</module>
        <module>risk-decision</module>
        <module>risk-control</module>
        <module>risk-compliance</module>
        <module>risk-web</module>
        <module>risk-test</module>
    </modules>
    <dependencyManagement>
        <dependencies>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>risk-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>risk-decision</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>risk-control</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>risk-compliance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.paytech</groupId>
            <artifactId>risk-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>risk-bootstrap-scope</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.flywaydb:*</exclude>
                                        <exclude>org.liquibase:*</exclude>
                                        <exclude>com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>com.rabbitmq:*</exclude>
                                        <exclude>com.xuxueli:*</exclude>
                                        <exclude>com.paytech:paytech-compensation-event</exclude>
                                        <exclude>com.paytech:paytech-xxl-job-starter</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-gateway*</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-starter-openfeign</exclude>
                                        <exclude>org.apache.dubbo:*</exclude>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>org.testcontainers:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
